# POSIX socket wrapper for the Aoxn web benchmark server (Linux / macOS).
# Same interface as sock_win.ax. `socket`/`accept`/`bind`/`listen`/`close`
# return C `int` (zero-extended on return, hence `i32`); `recv`/`send` return
# `ssize_t` and pass straight through.

import "../stdlib/stdlib.ax"

extern def socket(af: int, ty: int, proto: int) -> int
extern def bind(s: int, name: int, namelen: int) -> int
extern def listen(s: int, backlog: int) -> int
extern def accept(s: int, name: int, namelen: int) -> int
extern def recv(s: int, buf: int, n: int, flags: int) -> int
extern def send(s: int, buf: int, n: int, flags: int) -> int
extern def setsockopt(s: int, level: int, optname: int, optval: int, optlen: int) -> int
extern def close(s: int) -> int
extern def clock_gettime(clk: int, ts: int) -> int

def i32(r: int) -> int:
    if r == 4294967295:
        return -1
    return r

def net_init() -> int:
    return 0

def net_listen(port: int) -> int:
    s = i32(socket(2, 1, 0))
    if s == -1:
        return -1
    # SO_REUSEADDR before bind: without it a restart (or the previous test
    # server) leaves TIME_WAIT connections that make bind fail with
    # EADDRINUSE on Linux/macOS. Constants differ per platform:
    # Linux SOL_SOCKET=1 SO_REUSEADDR=2; macOS/BSD SOL_SOCKET=65535
    # SO_REUSEADDR=4.
    opt = malloc(4)
    store_u8(opt, 0, 1)
    if target_os() == "linux":
        setsockopt(s, 1, 2, opt, 4)
    else:
        setsockopt(s, 65535, 4, opt, 4)
    addr = malloc(16)
    fill_zero(addr, 16)
    if target_os() == "macos":
        store_u8(addr, 0, 16)
        store_u8(addr, 1, 2)
    else:
        store_u8(addr, 0, 2)
    store_u8(addr, 2, port / 256)
    store_u8(addr, 3, port % 256)
    if i32(bind(s, addr, 16)) == -1:
        return -1
    if i32(listen(s, 128)) == -1:
        return -1
    return s

def net_accept(ls: int) -> int:
    return i32(accept(ls, 0, 0))

def net_recv(cs: int, buf: int, cap: int) -> int:
    return recv(cs, buf, cap, 0)

def net_send_all(cs: int, buf: int, n: int) -> int:
    sent = 0
    while sent < n:
        k = send(cs, buf + sent, n - sent, 0)
        if k <= 0:
            return -1
        sent = sent + k
    return sent

def net_close(s: int):
    close(s)

# TCP_NODELAY (optval is a caller-owned 4-byte buffer holding the int 1)
def net_set_nodelay(s: int, optval: int):
    setsockopt(s, 6, 1, optval, 4)

# wall-clock nanoseconds via clock_gettime(CLOCK_REALTIME); slot 104 of the
# metrics block must hold a 16-byte timespec scratch
def net_now_ns(m: int) -> int:
    ts = load_i64(m + 104)
    clock_gettime(0, ts)
    sec = load_i64(ts)
    nsec = load_i64(ts + 8)
    return sec * 1000000000 + nsec
