# Winsock2 socket wrapper for the Aoxn web benchmark server (Windows).
# Pointers cross the C FFI as plain `int`. Every C `int` return arrives
# zero-extended in an i64, so -1 shows up as 4294967295; `i32` below maps
# that back (a true 64-bit -1 passes through unchanged).

import "../stdlib/stdlib.ax"

extern def WSAStartup(version: int, data: int) -> int
extern def socket(af: int, ty: int, proto: int) -> int
extern def bind(s: int, name: int, namelen: int) -> int
extern def listen(s: int, backlog: int) -> int
extern def accept(s: int, name: int, namelen: int) -> int
extern def recv(s: int, buf: int, n: int, flags: int) -> int
extern def send(s: int, buf: int, n: int, flags: int) -> int
extern def setsockopt(s: int, level: int, optname: int, optval: int, optlen: int) -> int
extern def closesocket(s: int) -> int
extern def QueryPerformanceCounter(p: int) -> int
extern def QueryPerformanceFrequency(p: int) -> int

def i32(r: int) -> int:
    if r == 4294967295:
        return -1
    return r

def net_init() -> int:
    wsadata = malloc(512)
    return i32(WSAStartup(514, wsadata))

def net_listen(port: int) -> int:
    s = socket(2, 1, 0)
    if s == -1:
        return -1
    addr = malloc(16)
    fill_zero(addr, 16)
    store_u8(addr, 0, 2)
    store_u8(addr, 2, port / 256)
    store_u8(addr, 3, port % 256)
    if i32(bind(s, addr, 16)) == -1:
        return -1
    if i32(listen(s, 128)) == -1:
        return -1
    return s

def net_accept(ls: int) -> int:
    return accept(ls, 0, 0)

def net_recv(cs: int, buf: int, cap: int) -> int:
    return i32(recv(cs, buf, cap, 0))

def net_send_all(cs: int, buf: int, n: int) -> int:
    sent = 0
    while sent < n:
        k = i32(send(cs, buf + sent, n - sent, 0))
        if k <= 0:
            return -1
        sent = sent + k
    return sent

def net_close(s: int):
    closesocket(s)

# TCP_NODELAY (optval is a caller-owned 4-byte buffer holding the int 1)
def net_set_nodelay(s: int, optval: int):
    setsockopt(s, 6, 1, optval, 4)

# wall-clock nanoseconds via QueryPerformanceCounter; slot 104 of the
# metrics block must hold a 16-byte scratch [counter, freq]
def net_now_ns(m: int) -> int:
    p = load_i64(m + 104)
    QueryPerformanceCounter(p)
    QueryPerformanceFrequency(p + 8)
    c = load_i64(p)
    f = load_i64(p + 8)
    return (c / f) * 1000000000 + (c % f) * 1000000000 / f
