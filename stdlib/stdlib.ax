# Aoxn standard library (stdlib) — written in Aoxn itself.
# Generic functions are monomorphized per (type, length) at each call site.
# C FFI math is declared via `extern def`.

# ---- C runtime math (FFI) ----
extern def sqrt(x: float) -> float
extern def floor(x: float) -> float
extern def ceil(x: float) -> float

# ---- integer math ----

def abs_i(n: int) -> int:
    if n < 0:
        return -n
    return n

def min_i(a: int, b: int) -> int:
    if a < b:
        return a
    return b

def max_i(a: int, b: int) -> int:
    if a > b:
        return a
    return b

def clamp_i(v: int, lo: int, hi: int) -> int:
    return min_i(max_i(v, lo), hi)

# fast integer power: base^exp for exp >= 0 (overflow wraps like C)
def pow_i(base: int, exp: int) -> int:
    result = 1
    b = base
    e = exp
    while e > 0:
        if e % 2 == 1:
            result = result * b
        b = b * b
        e = e / 2
    return result

def gcd(a: int, b: int) -> int:
    a = abs_i(a)
    b = abs_i(b)
    while b > 0:
        t = a % b
        a = b
        b = t
    return a

def lcm(a: int, b: int) -> int:
    if a == 0 or b == 0:
        return 0
    return a / gcd(a, b) * b

# integer square root (Newton's method, floors toward zero)
def isqrt(n: int) -> int:
    if n < 2:
        return n
    x = n
    y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    return x

# ---- float math ----

def abs_f(x: float) -> float:
    if x < 0.0:
        return -x
    return x

def min_f(a: float, b: float) -> float:
    if a < b:
        return a
    return b

def max_f(a: float, b: float) -> float:
    if a > b:
        return a
    return b

def clamp_f(v: float, lo: float, hi: float) -> float:
    return min_f(max_f(v, lo), hi)

def hypot(a: float, b: float) -> float:
    return sqrt(a * a + b * b)

# ---- primality ----

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d = d + 1
    return True

# ---- generic search ----
# returns the index of the first match, or -1 when absent

def linear_search[T, N](arr: [T; N], target: T) -> int:
    for i in range(N):
        if arr[i] == target:
            return i
    return -1

# binary search: arr must be sorted ascending
def binary_search[T, N](arr: [T; N], target: T) -> int:
    lo = 0
    hi = N - 1
    while lo <= hi:
        mid = (lo + hi) / 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

# ---- generic sort ----
# value semantics: returns a sorted copy, the input is untouched

def sort[T, N](arr: [T; N]) -> [T; N]:
    result = arr
    for i in range(N):
        for j in range(N - 1 - i):
            if result[j] > result[j + 1]:
                t = result[j]
                result[j] = result[j + 1]
                result[j + 1] = t
    return result

# ---- generic array helpers ----

def sum_int[N](arr: [int; N]) -> int:
    total = 0
    for x in arr:
        total = total + x
    return total

def sum_float[N](arr: [float; N]) -> float:
    total = 0.0
    for x in arr:
        total = total + x
    return total

def max_of[T, N](arr: [T; N]) -> T:
    m = arr[0]
    for x in arr:
        if x > m:
            m = x
    return m

def min_of[T, N](arr: [T; N]) -> T:
    m = arr[0]
    for x in arr:
        if x < m:
            m = x
    return m

def reverse[T, N](arr: [T; N]) -> [T; N]:
    result = arr
    i = 0
    j = N - 1
    while i < j:
        t = result[i]
        result[i] = result[j]
        result[j] = t
        i = i + 1
        j = j - 1
    return result

# ---- raw memory & dynamic arrays (self-hosting foundation, v0.9) ----
# Addresses are plain `int` (pointer-sized). The load/store builtins are
# unsafe by nature: bounds and lifetimes are the caller's responsibility.

extern def malloc(size: int) -> int
extern def realloc(p: int, size: int) -> int
extern def free(p: int)
extern def memcpy(dst: int, src: int, n: int) -> int

# growable array of 8-byte slots (ints, bools as 0/1, strings via as_ptr)
struct Vec:
    data: int
    len: int
    cap: int

def vec_new() -> Vec:
    return Vec(data=0, len=0, cap=0)

def vec_push(v: Vec, item: int) -> Vec:
    if v.len == v.cap:
        newcap = v.cap * 2
        if newcap == 0:
            newcap = 8
        v.data = realloc(v.data, newcap * 8)
        v.cap = newcap
    store_i64(v.data + v.len * 8, item)
    v.len = v.len + 1
    return v

def vec_get(v: Vec, i: int) -> int:
    return load_i64(v.data + i * 8)

def vec_set(v: Vec, i: int, item: int):
    store_i64(v.data + i * 8, item)

def vec_free(v: Vec):
    free(v.data)

def vec_pop(v: Vec) -> Vec:
    return Vec(data=v.data, len=v.len - 1, cap=v.cap)

# ---- byte/string buffers ----

def fill_zero(p: int, n: int):
    i = 0
    while i < n:
        store_u8(p, i, 0)
        i = i + 1

def buf_new(cap: int) -> int:
    b = malloc(cap)
    fill_zero(b, cap)
    return b

def str_get(s: string, i: int) -> int:
    return load_u8(s, i)

# char classification (bytes as int)
def is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

def is_alpha(c: int) -> bool:
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

def is_space(c: int) -> bool:
    return c == 32 or c == 9 or c == 10 or c == 13

# ---- inline CSS (CSS-in-Aoxn, v0.36.0) ----
#
# A typed wrapper around `style="..."` attributes, for the cases a stylesheet
# should not own: a value computed at run time. It is deliberately a *set of
# declarations*, not an object literal — neither language has one without an
# interface, and the alternative (string concatenation at every call site) is
# where quoting bugs live.
#
#   print(inline_style_2("color", "red", "margin", "0 auto"))
#
# The `N` variants exist because the language has one array length parameter
# per function, so a variadic builder cannot be written generically.

# Declarations are joined with "; " and the result is ready to drop into a
# `style` attribute. A value containing a quote is rejected rather than
# escaped: silently producing a broken attribute is worse than a clear error.
def css_decl_2(k1: string, v1: string, k2: string, v2: string) -> string:
    return css_check(k1, v1) + "; " + css_check(k2, v2)

def css_decl_3(k1: string, v1: string, k2: string, v2: string, k3: string, v3: string) -> string:
    return css_decl_2(k1, v1, k2, v2) + "; " + css_check(k3, v3)

def css_decl_1(k1: string, v1: string) -> string:
    return css_check(k1, v1)

# validate one `key: value` pair and return it
def css_check(key: string, value: string) -> string:
    if len(key) == 0:
        return ""
    if css_has_quote(value):
        # no way to report an error from the stdlib's string layer; an empty
        # declaration drops out of the join below rather than corrupting the
        # attribute
        return ""
    return key + ": " + value

def css_has_quote(s: string) -> bool:
    i = 0
    while i < len(s):
        c = str_get(s, i)
        if c == 34 or c == 39:
            return True
        i = i + 1
    return False

# ---- file IO ----

extern def fopen(path: string, mode: string) -> int
extern def fread(buf: int, size: int, count: int, f: int) -> int
extern def fwrite(buf: int, size: int, count: int, f: int) -> int
extern def fseek(f: int, off: int, origin: int) -> int
extern def ftell(f: int) -> int
extern def fclose(f: int) -> int

# read an entire file as a string (empty string when it cannot be opened)
def read_file(path: string) -> string:
    f = fopen(path, "rb")
    if f == 0:
        return ""
    fseek(f, 0, 2)
    size = ftell(f)
    fseek(f, 0, 0)
    buf = malloc(size + 1)
    fread(buf, 1, size, f)
    store_u8(buf, size, 0)
    fclose(f)
    return as_string(buf)

# write a string to a file (returns false when it cannot be opened)
def write_file(path: string, content: string) -> bool:
    f = fopen(path, "wb")
    if f == 0:
        return False
    fwrite(as_ptr(content), 1, len(content), f)
    fclose(f)
    return True

# ---- process location ----
#
# A compiled program cannot learn where it lives on its own: `main` takes no
# arguments and Aoxn has no argv/cwd builtin. `GetModuleFileNameA` is how the
# Windows loader answers that, and kernel32 is already linked through the CRT,
# so this needs no compiler change and no `-l`.

extern def GetModuleFileNameA(module: int, buf: int, size: int) -> int
extern def GetModuleHandleA(name: int) -> int

# full path of the running executable, without a trailing separator
def exe_path() -> string:
    buf = malloc(1024)
    n = GetModuleFileNameA(GetModuleHandleA(0), buf, 1024)
    if n <= 0:
        return ""
    store_u8(buf, n, 0)
    return as_string(buf)

# directory containing the running executable, without a trailing separator.
# This is where `aoxn build --emit-assets assets` writes its fingerprinted
# files, so a server finds them under `exe_dir() + "/assets"`.
def exe_dir() -> string:
    path = exe_path()
    n = len(path)
    i = n - 1
    # strip the file name; both separators are checked because a Windows path
    # may carry either. The prefix is copied into a fresh buffer rather than
    # sliced, because the language has no substring builtin.
    while i >= 0:
        # str_get yields a byte, so the separators are compared as byte values
        # (47 = '/', 92 = '\'), never as string literals
        c = str_get(path, i)
        if c == 47 or c == 92:
            buf = malloc(i + 1)
            j = 0
            while j < i:
                store_u8(buf, j, load_u8(path, j))
                j = j + 1
            store_u8(buf, i, 0)
            return as_string(buf)
        i = i - 1
    return ""

# Filesystem location of an asset emitted beside the executable. The `name` is
# what `styles_fingerprint()` returns; a server maps a request URL onto this
# directory.
def asset_path(name: string) -> string:
    return exe_dir() + "\\assets\\" + name

# run a shell command, returning the raw C `system()` value: a wait status on
# POSIX, the process exit code on Windows. Most callers want `system_exit_code`
# below, which normalizes both.
extern def system(cmd: string) -> int

# run a shell command and return its exit code on every platform.
# POSIX `system()` reports a wait status (`exit 7` -> 1792) while Windows
# reports the exit code directly; a process killed by a signal is reported
# shell-style as 128 + signal. Returns -1 when the shell cannot be started.
def system_exit_code(cmd: string) -> int:
    raw = system(cmd)
    if target_os() == "windows":
        return raw
    if raw == -1:
        return -1
    if raw % 128 != 0:
        return 128 + raw % 128
    return raw / 256
