# Aoxn UI — Windows backend (Win32 + GDI), Qt-flavored immediate mode.
#
# Import this INSTEAD of ui.ax to get the full widget set in one flat
# namespace; ui.ax (portable half) comes in transitively:
#   import "../stdlib/ui_win.ax"
#   ... Aoxn run app.ax -l user32 -l gdi32
#
# Backend notes (why there are no callbacks anywhere):
#   - The window procedure IS DefWindowProcW (address via GetProcAddress —
#     Aoxn cannot pass function pointers). Messages are drained and
#     dispatched by ui_frame; everything else is POLLED per frame:
#     GetCursorPos + ScreenToClient (mouse), GetAsyncKeyState (buttons and
#     a 256-key snapshot with per-frame edge detection), GetClientRect
#     (resize). Clicking X destroys the window; IsWindow() goes false and
#     the app loop ends.
#   - Drawing is GDI into a memory DC (double buffered, CS_OWNDC) blitted
#     once per frame by ui_present; the class background brush is NULL so
#     nothing else ever erases the window (no flicker).
#   - MsgWaitForMultipleObjects caps idle frames at c.cap_ms (default 15ms
#     ~ 66 fps): the loop sleeps when nothing happens instead of spinning.
#   - All Win32 constants are DECIMAL (no hex literals, no bitwise ops in
#     the language — flags are summed by hand and byte fields are read via
#     i32_at from ui.ax).
#   - exes are console-subsystem (the compiler links the default CRT
#     entry), so ui_init calls FreeConsole() to drop the stray console
#     window. Piped stdout (tests, CI) keeps working: handles stay valid.
#
# Widget state lives where the language can express it: with the caller
# (checkbox/slider values are taken and returned) or in the shared heap
# block (ui.ax header documents the slot layout) — never in callbacks.

import * from "./ui.ax"
# ---- C ABI surface (kernel32 + CRT link by default; -l user32 -l gdi32) ----

extern def LoadLibraryA(name: string) -> int
extern def GetProcAddress(mod: int, name: string) -> int
extern def GetModuleHandleW(name: int) -> int
extern def RegisterClassW(wc: int) -> int
extern def CreateWindowExW(ex: int, cls: string, title: string, style: int, x: int, y: int, w: int, h: int, parent: int, menu: int, inst: int, param: int) -> int
extern def ShowWindow(hwnd: int, cmd: int) -> int
extern def DestroyWindow(hwnd: int) -> int
extern def IsWindow(hwnd: int) -> int
extern def GetClientRect(hwnd: int, rect: int) -> int
extern def AdjustWindowRect(rect: int, style: int, menu: int) -> int
extern def GetDC(hwnd: int) -> int
extern def ReleaseDC(hwnd: int, dc: int) -> int
extern def GetCursorPos(pt: int) -> int
extern def ScreenToClient(hwnd: int, pt: int) -> int
extern def GetAsyncKeyState(vk: int) -> int
extern def GetForegroundWindow() -> int
extern def LoadCursorW(inst: int, id: int) -> int
extern def SetProcessDPIAware() -> int
extern def FreeConsole() -> int
extern def MsgWaitForMultipleObjects(n: int, handles: int, all: int, ms: int, mask: int) -> int
extern def PeekMessageW(msg: int, hwnd: int, lo: int, hi: int, remove: int) -> int
# TranslateMessage has no W-suffixed export: its MSG* parameter is
# charset-neutral, and user32.lib only carries the bare name
extern def TranslateMessage(msg: int) -> int
extern def DispatchMessageW(msg: int) -> int
extern def MessageBoxW(parent: int, text: string, caption: string, flags: int) -> int
extern def lstrlenW(s: string) -> int
extern def SetTextAlign(dc: int, mode: int) -> int
extern def CreateCompatibleDC(dc: int) -> int
extern def CreateCompatibleBitmap(dc: int, w: int, h: int) -> int
extern def SelectObject(dc: int, obj: int) -> int
extern def DeleteObject(obj: int) -> int
extern def DeleteDC(dc: int) -> int
extern def BitBlt(dst: int, x: int, y: int, w: int, h: int, src: int, sx: int, sy: int, rop: int) -> int
extern def SetBkMode(dc: int, mode: int) -> int
extern def SetTextColor(dc: int, color: int) -> int
extern def SetDCBrushColor(dc: int, color: int) -> int
extern def SetDCPenColor(dc: int, color: int) -> int
extern def GetStockObject(i: int) -> int
extern def Rectangle(dc: int, l: int, t: int, r: int, b: int) -> int
extern def RoundRect(dc: int, l: int, t: int, r: int, b: int, ew: int, eh: int) -> int
extern def MoveToEx(dc: int, x: int, y: int, prev: int) -> int
extern def LineTo(dc: int, x: int, y: int) -> int
extern def TextOutW(dc: int, x: int, y: int, s: string, n: int) -> int
extern def GetTextExtentPoint32W(dc: int, s: string, n: int, size: int) -> int
extern def CreateFontW(h: int, w: int, esc: int, ori: int, weight: int, italic: int, underline: int, strike: int, charset: int, outp: int, clipp: int, qual: int, pitch: int, face: string) -> int
extern def GetTickCount64() -> int
extern def SaveDC(dc: int) -> int
extern def RestoreDC(dc: int, saved: int) -> int
extern def IntersectClipRect(dc: int, l: int, t: int, r: int, b: int) -> int
extern def Ellipse(dc: int, l: int, t: int, r: int, b: int) -> int

# ---- drawing primitives ----

# stock objects used below: NULL_BRUSH=5 NULL_PEN=8 DC_BRUSH=18 DC_PEN=19
def ui_fill_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(18))
    SetDCBrushColor(c.mem_dc, color)
    SelectObject(c.mem_dc, GetStockObject(8))
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def ui_frame_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(19))
    SetDCPenColor(c.mem_dc, color)
    SelectObject(c.mem_dc, GetStockObject(5))
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def round_fill(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    SelectObject(c.mem_dc, GetStockObject(18))
    SetDCBrushColor(c.mem_dc, fill)
    SelectObject(c.mem_dc, GetStockObject(19))
    SetDCPenColor(c.mem_dc, border)
    RoundRect(c.mem_dc, x, y, x + w, y + h, 8, 8)

def ui_draw_line(c: UI, x1: int, y1: int, x2: int, y2: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(19))
    SetDCPenColor(c.mem_dc, color)
    MoveToEx(c.mem_dc, x1, y1, 0)
    LineTo(c.mem_dc, x2, y2)

def ui_draw_text(c: UI, x: int, y: int, s: string, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, c.font)
    SetTextColor(c.mem_dc, color)
    p = utf16f(c, s)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def ui_draw_text_big(c: UI, x: int, y: int, s: string, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, c.font_big)
    SetTextColor(c.mem_dc, color)
    p = utf16f(c, s)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def ui_measure(c: UI, s: string) -> TextSize:
    if target_os() != "windows":
        return TextSize(w=0, h=0)
    p = utf16f(c, s)
    n = lstrlenW(as_string(p))
    GetTextExtentPoint32W(c.mem_dc, as_string(p), n, c.rect)
    v = load_i64(c.rect)
    return TextSize(w=v % 4294967296, h=v / 4294967296)

# ---- input queries ----

def ui_mouse_in(c: UI, x: int, y: int, w: int, h: int) -> bool:
    return c.mx >= x and c.mx < x + w and c.my >= y and c.my < y + h

def ui_key_down(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1

# true only on the frame the key went down
def ui_key_pressed(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1 and st_get(c, 260 + vk) == 0

# ---- widgets (immediate mode: call every frame, own the state yourself) ----

# focus ring + keyboard activation shared by the interactive widgets
def focus_ring(c: UI, x: int, y: int, w: int, h: int, id: int, pal: Palette):
    if ui_focused(c, id):
        ui_frame_rect(c, x - 2, y - 2, w + 4, h + 4, pal.accent)

def key_activate(c: UI, id: int) -> bool:
    if not ui_focused(c, id):
        return False
    return ui_key_pressed(c, 13) or ui_key_pressed(c, 32)

def ui_button(c: UI, x: int, y: int, w: int, h: int, s: string) -> bool:
    if target_os() != "windows":
        return False
    id = ui_wid_id(x, y)
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    clicked = False
    if act == id and c.dn_prev and not c.dn:
        if hot:
            clicked = True
        st_set(c, 0, 0)
        act = 0
    if key_activate(c, id) and not off:
        clicked = True
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.widget
    if off:
        face = pal.disabled_face
    if hot and act == id:
        face = pal.widget_down
    elif hot:
        face = pal.widget_hover
    pen = pal.border
    if hot:
        pen = pal.accent
    ts = ui_measure(c, s)
    tx = x + (w - ts.w) / 2
    ty = y + (h - ts.h) / 2
    if hot and act == id:
        ty = ty + 1
    round_fill(c, x, y, w, h, face, pen)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, tx, ty, s, tcol)
    if not off:
        focus_ring(c, x, y, w, h, id, pal)
    return clicked

def ui_label(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text)

def ui_label_dim(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text_dim)

# label + decimal int without building a concatenated string per frame
def ui_label_int(c: UI, x: int, y: int, prefix: string, v: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, prefix, pal.text)
    ts = ui_measure(c, prefix)
    p = itoa10(c, v)
    ui_draw_text(c, x + ts.w, y, as_string(p), pal.text)

def ui_title(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text_big(c, x, y, s, pal.text)

def ui_checkbox(c: UI, x: int, y: int, s: string, checked: bool) -> bool:
    if target_os() != "windows":
        return checked
    result = checked
    off = ui_disabled(c)
    ts = ui_measure(c, s)
    hot = ui_mouse_in(c, x, y, 22 + ts.w, 20) and not off
    id = ui_wid_id(x, y)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = not checked
        st_set(c, 0, 0)
    if key_activate(c, id) and not off:
        result = not checked
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    box_face = pal.panel
    if off:
        box_face = pal.disabled_face
    ui_fill_rect(c, x, y + 2, 15, 15, box_face)
    ui_frame_rect(c, x, y + 2, 15, 15, pal.border)
    if checked:
        tick = pal.accent
        if off:
            tick = pal.disabled_text
        ui_draw_line(c, x + 3, y + 9, x + 6, y + 13, tick)
        ui_draw_line(c, x + 6, y + 13, x + 12, y + 4, tick)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, x + 22, y, s, tcol)
    if not off:
        focus_ring(c, x, y, 22 + ts.w, 20, id, pal)
    return result

# horizontal slider, 20 px tall; returns the (possibly dragged) value
def ui_slider(c: UI, x: int, y: int, w: int, value: int, vmin: int, vmax: int) -> int:
    if target_os() != "windows":
        return value
    id = ui_wid_id(x, y)
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x - 8, y - 4, w + 16, 28) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
        act = 0
    if act == id and c.dn:
        span = w - 10
        if span < 1:
            span = 1
        value = vmin + (c.mx - (x + 5)) * (vmax - vmin) / span
    if ui_focused(c, id) and not off:
        step = (vmax - vmin) / 20
        if step < 1:
            step = 1
        if ui_key_pressed(c, 37):
            value = value - step
        if ui_key_pressed(c, 39):
            value = value + step
    if value < vmin:
        value = vmin
    if value > vmax:
        value = vmax
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    ui_fill_rect(c, x + 4, y + 9, w - 8, 4, pal.groove)
    rng = vmax - vmin
    if rng < 1:
        rng = 1
    chunk = (value - vmin) * (w - 10) / rng
    if chunk < 0:
        chunk = 0
    if chunk > w - 10:
        chunk = w - 10
    if chunk > 0:
        fill = pal.accent
        if off:
            fill = pal.disabled_text
        ui_fill_rect(c, x + 4, y + 9, chunk, 4, fill)
    face = pal.widget
    if off:
        face = pal.disabled_face
    round_fill(c, x + chunk, y + 1, 10, 18, face, pal.border)
    if not off:
        focus_ring(c, x, y, w, 20, id, pal)
    return value

def ui_progress(c: UI, x: int, y: int, w: int, value: int, vmax: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 8, pal.groove)
    top = vmax
    if top < 1:
        top = 1
    cw = value * w / top
    if cw < 0:
        cw = 0
    if cw > w:
        cw = w
    if cw > 0:
        ui_fill_rect(c, x, y, cw, 8, pal.accent)

def ui_separator(c: UI, x: int, y: int, w: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 1, pal.border)

def ui_panel(c: UI, x: int, y: int, w: int, h: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, h, pal.panel)

# ---- widgets v2: selection, text input, containers, overlays ----

# toggle (checkable push button): on = accent face + selected text
def ui_toggle(c: UI, x: int, y: int, w: int, h: int, s: string, on: bool) -> bool:
    if target_os() != "windows":
        return on
    result = on
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = not on
        st_set(c, 0, 0)
        act = 0
    if key_activate(c, id) and not off:
        result = not on
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.widget
    tcol = pal.text
    if result:
        face = pal.accent
        tcol = pal.sel_text
    if off:
        face = pal.disabled_face
        tcol = pal.disabled_text
    if hot and act == id:
        face = pal.widget_down
        if result:
            face = pal.sel
    pen = pal.border
    if hot:
        pen = pal.accent
    ts = ui_measure(c, s)
    tx = x + (w - ts.w) / 2
    ty = y + (h - ts.h) / 2
    if hot and act == id:
        ty = ty + 1
    round_fill(c, x, y, w, h, face, pen)
    ui_draw_text(c, tx, ty, s, tcol)
    if not off:
        focus_ring(c, x, y, w, h, id, pal)
    return result

# radio button inside an exclusive group: `group` is the group's current
# value, `item` is this button's value; returns the (possibly new) value
def ui_radio(c: UI, x: int, y: int, s: string, group: int, item: int) -> int:
    if target_os() != "windows":
        return group
    result = group
    off = ui_disabled(c)
    ts = ui_measure(c, s)
    hot = ui_mouse_in(c, x, y, 22 + ts.w, 20) and not off
    id = ui_wid_id(x, y)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = item
        st_set(c, 0, 0)
    if key_activate(c, id) and not off:
        result = item
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    # circle: filled disc + ring, inner dot when selected
    SelectObject(c.mem_dc, GetStockObject(18))
    ring_face = pal.panel
    if off:
        ring_face = pal.disabled_face
    SetDCBrushColor(c.mem_dc, ring_face)
    SelectObject(c.mem_dc, GetStockObject(19))
    SetDCPenColor(c.mem_dc, pal.border)
    Ellipse(c.mem_dc, x, y + 3, x + 15, y + 18)
    if result == item:
        SelectObject(c.mem_dc, GetStockObject(18))
        dot = pal.accent
        if off:
            dot = pal.disabled_text
        SetDCBrushColor(c.mem_dc, dot)
        SelectObject(c.mem_dc, GetStockObject(8))
        Ellipse(c.mem_dc, x + 4, y + 7, x + 11, y + 14)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, x + 22, y, s, tcol)
    if not off:
        focus_ring(c, x, y, 22 + ts.w, 20, id, pal)
    return result

# Qt-style group box: thin frame with the title punched through the top line
def ui_groupbox(c: UI, x: int, y: int, w: int, h: int, title: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_frame_rect(c, x, y + 8, w, h - 8, pal.border)
    if len(title) > 0:
        ts = ui_measure(c, title)
        ui_fill_rect(c, x + 12, y, ts.w + 10, 16, pal.bg)
        ui_draw_text(c, x + 17, y, title, pal.text_dim)

# integer spin box: value field + stacked up/down buttons; arrows step by 1
# (shift of the range / 20 is NOT done — spin boxes count)
def ui_spinbox(c: UI, x: int, y: int, w: int, value: int, vmin: int, vmax: int) -> int:
    if target_os() != "windows":
        return value
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    h = 28
    btn_w = 20
    up_h = h / 2
    hot_up = ui_mouse_in(c, x + w - btn_w, y, btn_w, up_h) and not off
    hot_dn = ui_mouse_in(c, x + w - btn_w, y + up_h, btn_w, h - up_h) and not off
    hot = ui_mouse_in(c, x, y, w, h) and not off
    edge = c.dn and not c.dn_prev
    if edge and st_get(c, 0) == 0:
        if hot_up and value < vmax:
            value = value + 1
            ui_focus(c, id)
        elif hot_dn and value > vmin:
            value = value - 1
            ui_focus(c, id)
        elif hot:
            ui_focus(c, id)
    if ui_focused(c, id) and not off:
        if ui_key_pressed(c, 38) and value < vmax:
            value = value + 1
        if ui_key_pressed(c, 40) and value > vmin:
            value = value - 1
    if value < vmin:
        value = vmin
    if value > vmax:
        value = vmax
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    # stacked up/down buttons on the right
    up_face = pal.widget
    dn_face = pal.widget
    if hot_up:
        up_face = pal.widget_hover
    if hot_dn:
        dn_face = pal.widget_hover
    if off:
        up_face = pal.disabled_face
        dn_face = pal.disabled_face
    ui_fill_rect(c, x + w - btn_w, y, btn_w, up_h, up_face)
    ui_fill_rect(c, x + w - btn_w, y + up_h, btn_w, h - up_h, dn_face)
    ui_draw_line(c, x + w - btn_w, y + up_h, x + w, y + up_h, pal.border)
    acol = pal.text
    if off:
        acol = pal.disabled_text
    ts_up = ui_measure(c, "▲")
    ui_draw_text(c, x + w - btn_w + (btn_w - ts_up.w) / 2, y + 1, "▲", acol)
    ts_dn = ui_measure(c, "▼")
    ui_draw_text(c, x + w - btn_w + (btn_w - ts_dn.w) / 2, y + up_h + 1, "▼", acol)
    p = itoa10(c, value)
    ts_v = ui_measure(c, as_string(p))
    ui_draw_text(c, x + 8, y + (h - ts_v.h) / 2, as_string(p), acol)
    return value

# ---- text input ----

struct TextEdit:
    text: string
    changed: bool
    enter: bool

# caret x offset (px) inside a textbox; cached on (id, caret, len) so an idle
# focused box costs zero allocations per frame
def caret_px(c: UI, id: int, s: string, caret: int) -> int:
    if st_get(c, 532) == id and st_get(c, 533) == caret and st_get(c, 534) == len(s):
        return st_get(c, 535)
    sub = str_sub(s, 0, caret)
    ts = ui_measure(c, sub)
    st_set(c, 532, id)
    st_set(c, 533, caret)
    st_set(c, 534, len(s))
    st_set(c, 535, ts.w)
    return ts.w

# nearest caret byte offset to mouse x (walks codepoint widths; click only)
def text_pos_from_x(c: UI, s: string, tx: int, mx: int) -> int:
    n = len(s)
    i = 0
    prev_w = 0
    while i < n:
        j = caret_right(s, i)
        sub = str_sub(s, 0, j)
        ts = ui_measure(c, sub)
        if mx < tx + (prev_w + ts.w) / 2:
            return i
        prev_w = ts.w
        i = j
    return n

# single-line text field. Returns the edited text plus change/enter flags;
# the caller owns the string as always. Click focuses and positions the
# caret, Tab moves focus away, Enter reports `enter` (the app decides).
def ui_textbox(c: UI, x: int, y: int, w: int, h: int, text: string) -> TextEdit:
    res = TextEdit(text=text, changed=False, enter=False)
    if target_os() != "windows":
        return res
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    focused = ui_focused(c, id)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        ui_focus(c, id)
        focused = True
        st_set(c, 816, id)
        caret = text_pos_from_x(c, text, x + 8, c.mx)
        st_set(c, 539, caret)
    s = text
    caret = st_get(c, 539)
    if focused and st_get(c, 816) != id:
        # first frame of focus (e.g. via Tab): caret at end
        st_set(c, 816, id)
        caret = len(s)
    if caret > len(s):
        caret = len(s)
    if focused and not off:
        cnt = ui_char_count(c)
        if cnt > 0:
            ins = ui_char_str(c)
            s = str_insert(s, caret, ins)
            caret = caret + len(ins)
            res.changed = True
        if ui_key_pressed(c, 8) and caret > 0:
            nc = caret_left(s, caret)
            s = str_remove(s, nc, caret)
            caret = nc
            res.changed = True
        if ui_key_pressed(c, 46) and caret < len(s):
            nc = caret_right(s, caret)
            s = str_remove(s, caret, nc)
            res.changed = True
        if ui_key_pressed(c, 37):
            caret = caret_left(s, caret)
        if ui_key_pressed(c, 39):
            caret = caret_right(s, caret)
        if ui_key_pressed(c, 36):
            caret = 0
        if ui_key_pressed(c, 35):
            caret = len(s)
        if ui_key_pressed(c, 13):
            res.enter = True
    st_set(c, 539, caret)
    res.text = s
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if focused:
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    saved = SaveDC(c.mem_dc)
    IntersectClipRect(c.mem_dc, x + 4, y, x + w - 4, y + h)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ts = ui_measure(c, s)
    ty = y + (h - ts.h) / 2
    ui_draw_text(c, x + 8, ty, s, tcol)
    if focused and not off:
        if GetTickCount64() % 1000 < 650:
            cx = caret_px(c, id, s, caret)
            ui_fill_rect(c, x + 8 + cx, y + 5, 2, h - 10, pal.text)
    RestoreDC(c.mem_dc, saved)
    return res

# ---- list box ----

struct ListPick:
    cur: int
    scroll: int

# scrollable single-select list. `scroll` is the first visible item (the
# caller keeps it, like every other widget value); wheel and the scrollbar
# move it. Returns the selection and the updated scroll offset.
def ui_listbox[N](c: UI, x: int, y: int, w: int, h: int, items: [string; N], n: int, cur: int, scroll: int) -> ListPick:
    if target_os() != "windows":
        return ListPick(cur=cur, scroll=scroll)
    item_h = 26
    vis = h / item_h
    if vis < 1:
        vis = 1
    maxs = n - vis
    if maxs < 0:
        maxs = 0
    if scroll > maxs:
        scroll = maxs
    if scroll < 0:
        scroll = 0
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    has_sb = n > vis
    sbw = 12
    if not has_sb:
        sbw = 0
    hot = ui_mouse_in(c, x, y, w - sbw, h) and not off
    if hot and has_sb and not off:
        scroll = scroll - ui_wheel(c) / 120
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    saved = SaveDC(c.mem_dc)
    IntersectClipRect(c.mem_dc, x + 1, y + 1, x + w - sbw - 1, y + h - 1)
    sel_y = -1
    i = 0
    while i < vis and i < n:
        it = i + scroll
        iy = y + i * item_h
        if it == cur:
            ui_fill_rect(c, x + 1, iy, w - sbw - 2, item_h, pal.sel)
            sel_y = iy
        elif hot and c.my >= iy and c.my < iy + item_h:
            ui_fill_rect(c, x + 1, iy, w - sbw - 2, item_h, pal.widget_hover)
        tcol = pal.text
        if it == cur:
            tcol = pal.sel_text
        if off:
            tcol = pal.disabled_text
        ui_draw_text(c, x + 8, iy + (item_h - 16) / 2, items[it], tcol)
        i = i + 1
    RestoreDC(c.mem_dc, saved)
    # selection: press + release inside the list
    if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
        ui_focus(c, id)
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        if hot:
            it = scroll + (c.my - y) / item_h
            if it >= 0 and it < n:
                cur = it
        st_set(c, 0, 0)
    # scrollbar
    if has_sb:
        sbid = ui_wid_id(x + w, y)
        ui_fill_rect(c, x + w - sbw, y, sbw, h, pal.groove)
        track = h - 24
        if track < 1:
            track = 1
        th = h * vis / n
        if th < 24:
            th = 24
        if th > h:
            th = h
        ty2 = y + (h - th) * scroll / maxs
        if maxs == 0:
            ty2 = y
        tface = pal.widget
        hot_sb = ui_mouse_in(c, x + w - sbw, y, sbw, h) and not off
        if st_get(c, 0) == sbid:
            tface = pal.widget_down
        elif hot_sb:
            tface = pal.widget_hover
        round_fill(c, x + w - sbw + 2, ty2, sbw - 4, th, tface, pal.border)
        if hot_sb and c.dn and not c.dn_prev and st_get(c, 0) == 0:
            st_set(c, 0, sbid)
        if st_get(c, 0) == sbid and c.dn:
            denom = h - th
            if denom < 1:
                denom = 1
            scroll = (c.my - y - th / 2) * maxs / denom
            if scroll > maxs:
                scroll = maxs
            if scroll < 0:
                scroll = 0
        if st_get(c, 0) == sbid and c.dn_prev and not c.dn:
            st_set(c, 0, 0)
    return ListPick(cur=cur, scroll=scroll)

# ---- tab bar ----

# tab strip: click selects; the caller draws the page content below
def ui_tabs[N](c: UI, x: int, y: int, w: int, labels: [string; N], n: int, cur: int) -> int:
    if target_os() != "windows":
        return cur
    off = ui_disabled(c)
    th = 30
    pal = ui_palette_get(c)
    tx = x
    i = 0
    while i < n:
        ts = ui_measure(c, labels[i])
        tw = ts.w + 28
        if i == cur:
            ui_fill_rect(c, tx, y, tw, th, pal.panel)
            ui_fill_rect(c, tx, y, tw, 3, pal.accent)
            ui_draw_text(c, tx + 14, y + (th - ts.h) / 2 + 1, labels[i], pal.text)
        else:
            ui_fill_rect(c, tx, y, tw, th, pal.widget)
            tcol = pal.text_dim
            if off:
                tcol = pal.disabled_text
            ui_draw_text(c, tx + 14, y + (th - ts.h) / 2 + 1, labels[i], tcol)
        hot = ui_mouse_in(c, tx, y, tw, th) and not off
        id = ui_wid_id(x + i, y)
        if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
            st_set(c, 0, id)
            ui_focus(c, id)
        if st_get(c, 0) == id and c.dn_prev and not c.dn:
            if hot:
                cur = i
            st_set(c, 0, 0)
        if hot:
            ui_frame_rect(c, tx, y, tw, th, pal.accent)
        tx = tx + tw
        i = i + 1
    ui_fill_rect(c, x, y + th, w, 1, pal.border)
    return cur

# ---- combo box (drop-down; the popup list is drawn on top in ui_present) ----

# closed: a button with the current item; press opens a popup list below.
# The popup survives frames via the overlay record; pressing an item picks
# it (and swallows the click), pressing anywhere else closes without a pick.
def ui_combobox[N](c: UI, x: int, y: int, w: int, items: [string; N], n: int, cur: int) -> int:
    if target_os() != "windows":
        return cur
    if cur < 0:
        cur = 0
    if cur >= n:
        cur = n - 1
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    h = 28
    item_h = 26
    vis = n
    if vis > 12:
        vis = 12
    ov = ui_overlay_kind(c)
    mine = ov == 1 and st_get(c, 546) == id
    edge = c.dn and not c.dn_prev
    hot = ui_mouse_in(c, x, y, w, h) and not off
    # popup geometry (matches what ui_present draws)
    py = y + h
    ph = vis * item_h
    in_popup = mine and ui_mouse_in(c, x, py, w, ph) and not off
    if edge and not off:
        if mine and hot:
            ui_overlay_clear(c)
            st_set(c, 0, -1)
        elif mine and in_popup:
            it = st_get(c, 553) + (c.my - py) / item_h
            if it >= 0 and it < n:
                cur = it
            ui_overlay_clear(c)
            st_set(c, 0, -1)
        elif mine:
            ui_overlay_clear(c)
        elif hot and (st_get(c, 0) == 0 or ov == 1):
            st_set(c, 545, 1)
            st_set(c, 546, id)
            st_set(c, 547, x)
            st_set(c, 548, py)
            st_set(c, 549, w)
            st_set(c, 550, item_h)
            st_set(c, 551, n)
            st_set(c, 552, cur)
            st_set(c, 553, 0)
            overlay_items_store(c, items, n)
            st_set(c, 0, -1)
    if mine and in_popup and not edge:
        scroll = st_get(c, 553) - ui_wheel(c) / 120
        maxs = n - vis
        if maxs < 0:
            maxs = 0
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
        st_set(c, 553, scroll)
    if not off:
        ui_focus_reg(c, id)
    # closed box
    pal = ui_palette_get(c)
    face = pal.widget
    tcol = pal.text
    if off:
        face = pal.disabled_face
        tcol = pal.disabled_text
    pen = pal.border
    if hot or mine:
        pen = pal.accent
    round_fill(c, x, y, w, h, face, pen)
    if n > 0:
        ts = ui_measure(c, items[cur])
        ui_draw_text(c, x + 10, y + (h - ts.h) / 2, items[cur], tcol)
    ts_a = ui_measure(c, "▼")
    ui_draw_text(c, x + w - ts_a.w - 10, y + (h - ts_a.h) / 2, "▼", tcol)
    if ui_focused(c, id) and not off:
        focus_ring(c, x, y, w, h, id, pal)
    return cur

# ---- scroll area (clipped viewport with wheel + scrollbar) ----

# Begin a clipped viewport: returns the NEW scroll offset; draw your content
# at (x + pad, y - scroll). ui_scroll_end MUST close the region (it pops the
# GDI clip stack). content_h is the full height of the content in px.
def ui_scroll_begin(c: UI, x: int, y: int, w: int, h: int, scroll_y: int, content_h: int) -> int:
    if target_os() != "windows":
        return scroll_y
    maxs = content_h - h
    if maxs < 0:
        maxs = 0
    has_sb = content_h > h
    sbw = 12
    if not has_sb:
        sbw = 0
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    if hot and not off:
        scroll_y = scroll_y - ui_wheel(c) * 32 / 120
        if scroll_y > maxs:
            scroll_y = maxs
        if scroll_y < 0:
            scroll_y = 0
    # scrollbar input + draw happen BEFORE the content clip below, or the
    # bar would clip itself away (the clip excludes the scrollbar column)
    if has_sb:
        sbid = ui_wid_id(x + w, y)
        pal = ui_palette_get(c)
        th = h * h / content_h
        if th < 24:
            th = 24
        if th > h:
            th = h
        if st_get(c, 0) == sbid and c.dn:
            denom = h - th
            if denom < 1:
                denom = 1
            scroll_y = (c.my - y - th / 2) * maxs / denom
            if scroll_y > maxs:
                scroll_y = maxs
            if scroll_y < 0:
                scroll_y = 0
        if st_get(c, 0) == sbid and c.dn_prev and not c.dn:
            st_set(c, 0, 0)
        ui_fill_rect(c, x + w - sbw, y, sbw, h, pal.groove)
        ty = y
        if maxs > 0:
            ty = y + (h - th) * scroll_y / maxs
        tface = pal.widget
        hot_sb = ui_mouse_in(c, x + w - sbw, y, sbw, h) and not off
        if st_get(c, 0) == sbid:
            tface = pal.widget_down
        elif hot_sb:
            tface = pal.widget_hover
        round_fill(c, x + w - sbw + 2, ty, sbw - 4, th, tface, pal.border)
        if hot_sb and c.dn and not c.dn_prev and st_get(c, 0) == 0:
            st_set(c, 0, sbid)
    SaveDC(c.mem_dc)
    IntersectClipRect(c.mem_dc, x, y, x + w - sbw, y + h)
    return scroll_y

def ui_scroll_end(c: UI):
    if target_os() != "windows":
        return
    RestoreDC(c.mem_dc, -1)

# ---- tooltip (hover the rect for ~0.55s; drawn on top in ui_present) ----

def ui_tooltip(c: UI, x: int, y: int, w: int, h: int, text: string):
    if target_os() != "windows":
        return
    if ui_disabled(c):
        return
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x, y, w, h)
    if hot:
        ms = ui_hover_ms(c, id, GetTickCount64())
        if ms >= 550:
            st_set(c, 545, 2)
            st_set(c, 546, id)
            st_set(c, 547, c.mx)
            st_set(c, 548, c.my)
            st_set(c, 554, as_ptr(text))
    else:
        if st_get(c, 556) == id:
            ui_hover_reset(c)

# ---- core: lifecycle ----

def ui_init(title: string, w: int, h: int) -> UI:
    c = ui_new()
    if target_os() != "windows":
        print("ui_win: no backend for this platform yet (see docs/ui.md) — window stays closed")
        return c
    return init_win(c, title, w, h)

# window class style: CS_HREDRAW(2) + CS_VREDRAW(1) + CS_OWNDC(32)
def init_win(c: UI, title: string, w: int, h: int) -> UI:
    SetProcessDPIAware()
    FreeConsole()
    c = ui_state_init(c)
    c.msg = malloc(48)
    fill_zero(c.msg, 48)
    c.pt = malloc(8)
    c.rect = malloc(16)
    # WNDCLASSW (x64, 72 bytes): style, wndproc, extras, instance, cursor,
    # background brush = NULL (no erase flicker), class name
    cls = ui_utf16("AoxnUI")
    wc = malloc(72)
    fill_zero(wc, 72)
    user32 = LoadLibraryA("user32.dll")
    store_i64(wc, 35)
    store_i64(wc + 8, GetProcAddress(user32, "DefWindowProcW"))
    store_i64(wc + 24, GetModuleHandleW(0))
    store_i64(wc + 40, LoadCursorW(0, 32512))
    store_i64(wc + 64, cls)
    RegisterClassW(wc)
    # size the window so the CLIENT area is exactly w x h; the client rect is
    # {0, 0, w, h} — right and bottom share one i64 store (two 32-bit halves)
    store_i64(c.rect, 0)
    store_i64(c.rect + 8, w + h * 4294967296)
    AdjustWindowRect(c.rect, 13565952, 0)
    ww = i32_at(c.rect + 8) - i32_at(c.rect)
    wh = i32_at(c.rect + 12) - i32_at(c.rect + 4)
    t16 = ui_utf16(title)
    # CW_USEDEFAULT position = -2147483648; WS_OVERLAPPEDWINDOW = 13565952
    hwnd = CreateWindowExW(0, as_string(cls), as_string(t16), 13565952,
        -2147483648, -2147483648, ww, wh, 0, 0, load_i64(wc + 24), 0)
    free(wc)
    free(cls)
    free(t16)
    c.hwnd = hwnd
    c.open = hwnd != 0
    if not c.open:
        return c
    c.win_dc = GetDC(hwnd)
    c.mem_dc = CreateCompatibleDC(c.win_dc)
    c.bmp = CreateCompatibleBitmap(c.win_dc, w, h)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    c.font = make_font(-16, 400)
    c.font_big = make_font(-26, 700)
    SetBkMode(c.mem_dc, 1)
    SetTextAlign(c.mem_dc, 0)
    GetClientRect(hwnd, c.rect)
    c.w = i32_at(c.rect + 8)
    c.h = i32_at(c.rect + 12)
    pal = ui_palette_get(c)
    ui_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    ui_present(c)
    ShowWindow(hwnd, 5)
    return c

def make_font(px: int, weight: int) -> int:
    face = ui_utf16("Segoe UI")
    f = CreateFontW(px, 0, 0, 0, weight, 0, 0, 0, 1, 0, 0, 5, 0, as_string(face))
    free(face)
    return f

def resize_bitmap(c: UI, nw: int, nh: int) -> UI:
    if nw < 1 or nh < 1:
        return c
    SelectObject(c.mem_dc, c.old_bmp)
    DeleteObject(c.bmp)
    c.w = nw
    c.h = nh
    c.bmp = CreateCompatibleBitmap(c.win_dc, c.w, c.h)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    return c

# pump messages, sample input, reset the frame arena, fill the background.
# Returns the updated context; check c.open afterwards.
def ui_frame(c: UI) -> UI:
    if target_os() != "windows":
        return c
    return frame_win(c)

def frame_win(c: UI) -> UI:
    # per-frame input state that the drain loop accumulates
    st_set(c, 544, 0)
    c.wheel = 0
    st_set(c, 542, 0)
    if ui_overlay_kind(c) == 2:
        ui_overlay_clear(c)
    # idle cap: wake on any input or after cap_ms (~66 fps default);
    # QS_ALLINPUT = 1279
    MsgWaitForMultipleObjects(0, 0, 1, c.cap_ms, 1279)
    # drain pending messages; DefWindowProc validates paint and handles close.
    # MSG (x64): hwnd 0..8, message 8..12, wParam 16..24, lParam 24..32.
    # WM_CHAR (258) feeds the text queue (control units < 32 are dropped —
    # Enter/Backspace/Tab stay key events), WM_MOUSEWHEEL (522) accumulates
    # the signed high word of wParam (WHEEL_DELTA = 120 per notch).
    while PeekMessageW(c.msg, 0, 0, 0, 1) != 0:
        m = i32_at(c.msg + 8)
        if m == 258:
            ch = load_i64(c.msg + 16) % 65536
            if ch >= 32:
                ui_char_push(c, ch)
        elif m == 522:
            wp = load_i64(c.msg + 16)
            d = (wp / 65536) % 65536
            if d >= 32768:
                d = d - 65536
            st_set(c, 544, st_get(c, 544) + d)
        TranslateMessage(c.msg)
        DispatchMessageW(c.msg)
    c.wheel = st_get(c, 544)
    c.dn_prev = c.dn
    c.open = IsWindow(c.hwnd) != 0
    if not c.open:
        return c
    GetCursorPos(c.pt)
    ScreenToClient(c.hwnd, c.pt)
    c.mx = i32_at(c.pt)
    c.my = i32_at(c.pt + 4)
    if GetForegroundWindow() == c.hwnd:
        # GetAsyncKeyState returns a SHORT: bit 15 (32768) = down now, bit 0
        # (1) = pressed since the previous call — the latch catches presses
        # shorter than one frame gap that pure bit-15 sampling would miss.
        # ONE call per key per frame: a second call would clear the latch.
        k = GetAsyncKeyState(1)
        c.dn = k / 32768 == 1 or k % 2 == 1
        k = GetAsyncKeyState(2)
        c.dn2 = k / 32768 == 1 or k % 2 == 1
    else:
        c.dn = False
        c.dn2 = False
    i = 0
    while i < 256:
        st_set(c, 260 + i, st_get(c, 4 + i))
        st_set(c, 4 + i, 0)
        i = i + 1
    vk = 1
    while vk < 256:
        k = GetAsyncKeyState(vk)
        if k / 32768 == 1 or k % 2 == 1:
            st_set(c, 4 + vk, 1)
        vk = vk + 1
    # the overlay "eaten press" claim (act == -1) ends on release
    if st_get(c, 0) == -1 and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
    # tab order: last frame's registration becomes the focus chain
    focus_swap(c)
    if ui_key_pressed(c, 9):
        ui_focus_next(c, ui_key_down(c, 16))
    GetClientRect(c.hwnd, c.rect)
    nw = i32_at(c.rect + 8)
    nh = i32_at(c.rect + 12)
    if nw != c.w or nh != c.h:
        c = resize_bitmap(c, nw, nh)
    st_set(c, 2, 0)
    pal = ui_palette_get(c)
    ui_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    c.frames = c.frames + 1
    return c

def ui_present(c: UI):
    if target_os() != "windows":
        return
    if c.win_dc == 0 or c.mem_dc == 0:
        return
    ov = ui_overlay_kind(c)
    if ov == 1:
        draw_combo_popup(c)
    elif ov == 2:
        draw_tooltip_overlay(c)
    # SRCCOPY = 13369376
    BitBlt(c.win_dc, 0, 0, c.w, c.h, c.mem_dc, 0, 0, 13369376)

# combo popup list: drawn last so it floats above everything below it
def draw_combo_popup(c: UI):
    x = st_get(c, 547)
    y = st_get(c, 548)
    w = st_get(c, 549)
    item_h = st_get(c, 550)
    n = st_get(c, 551)
    scroll = st_get(c, 553)
    vis = n - scroll
    if vis > 12:
        vis = 12
    room = (c.h - y) / item_h
    if vis > room:
        vis = room
    if vis < 1:
        vis = 1
    ph = vis * item_h
    pal = ui_palette_get(c)
    ui_fill_rect(c, x + 3, y + 3, w, ph, pal.border)
    ui_fill_rect(c, x, y, w, ph, pal.panel)
    ui_frame_rect(c, x, y, w, ph, pal.border)
    saved = SaveDC(c.mem_dc)
    IntersectClipRect(c.mem_dc, x + 1, y + 1, x + w - 1, y + ph - 1)
    i = 0
    while i < vis:
        it = i + scroll
        if it >= n:
            i = vis
        else:
            iy = y + i * item_h
            if ui_mouse_in(c, x, iy, w, item_h):
                ui_fill_rect(c, x + 1, iy, w - 2, item_h, pal.sel)
                ui_draw_text(c, x + 10, iy + 4, overlay_item_str(c, it), pal.sel_text)
            else:
                ui_draw_text(c, x + 10, iy + 4, overlay_item_str(c, it), pal.text)
            i = i + 1
    RestoreDC(c.mem_dc, saved)

# tooltip: small framed label near the cursor
def draw_tooltip_overlay(c: UI):
    s = as_string(st_get(c, 554))
    pal = ui_palette_get(c)
    ts = ui_measure(c, s)
    x = st_get(c, 547) + 16
    y = st_get(c, 548) + 24
    if x + ts.w + 16 > c.w:
        x = c.w - ts.w - 16
    if y + ts.h + 12 > c.h:
        y = st_get(c, 548) - ts.h - 12
    if x < 0:
        x = 0
    if y < 0:
        y = 0
    ui_fill_rect(c, x + 2, y + 2, ts.w + 16, ts.h + 10, pal.border)
    ui_fill_rect(c, x, y, ts.w + 16, ts.h + 10, pal.tooltip_bg)
    ui_frame_rect(c, x, y, ts.w + 16, ts.h + 10, pal.border)
    ui_draw_text(c, x + 8, y + 5, s, pal.tooltip_text)

def ui_close(c: UI):
    if target_os() != "windows":
        return
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)

def ui_fini(c: UI):
    if target_os() != "windows":
        return
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)
    if c.mem_dc != 0:
        SelectObject(c.mem_dc, c.old_bmp)
        if c.bmp != 0:
            DeleteObject(c.bmp)
        DeleteDC(c.mem_dc)
    if c.win_dc != 0:
        ReleaseDC(c.hwnd, c.win_dc)
    if c.font != 0:
        DeleteObject(c.font)
    if c.font_big != 0:
        DeleteObject(c.font_big)
    ui_state_free(c)
    if c.msg != 0:
        free(c.msg)
    if c.pt != 0:
        free(c.pt)
    if c.rect != 0:
        free(c.rect)

def ui_alert(text: string, caption: string):
    if target_os() != "windows":
        print(text)
        return
    t16 = ui_utf16(text)
    c16 = ui_utf16(caption)
    MessageBoxW(0, as_string(t16), as_string(c16), 0)
