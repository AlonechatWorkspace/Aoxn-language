# Aoxn UI — an immediate-mode GUI standard library, Qt-flavored, in pure Aoxn.
#
# Design (forced by the language, kept Qt-like in spirit):
#   - Aoxn has no function pointers or closures, so callbacks/signals are
#     impossible. Widgets are plain functions evaluated every frame and the
#     app owns all state:  checked = ui_checkbox(c, x, y, "opt", checked)
#   - The Win32 backend registers DefWindowProcW itself as the window
#     procedure (address obtained via GetProcAddress — no callback of ours),
#     then polls everything per frame: GetCursorPos + ScreenToClient for the
#     mouse, GetAsyncKeyState for buttons/keys, GetClientRect for resizes.
#     A MsgWaitForMultipleObjects timeout caps the frame rate, so the loop
#     idles at ~66 fps instead of spinning.
#   - Drawing is GDI into a memory DC (double buffered), BitBlt-ed once per
#     frame by ui_present. All Win32 constants below are DECIMAL (Aoxn has
#     no hex literals and no bitwise operators — flags are summed by hand).
#   - Per-frame text goes through a 64 KiB bump arena that resets every
#     frame (utf16f/itoa10), so a steady-state UI leaks nothing. One-shot
#     init strings use ui_utf16 (malloc) and are freed immediately.
#
# Usage (Windows; links user32 + gdi32):
#   import "../stdlib/ui.ax"
#   def main() -> int:
#       c = ui_init("Hello", 640, 480)
#       clicks = 0
#       while c.open:
#           c = ui_frame(c)            # pump messages, sample input, begin frame
#           if c.open:
#               if ui_button(c, 20, 20, 120, 34, "Click me"):
#                   clicks = clicks + 1
#               ui_label_int(c, 20, 70, "clicks: ", clicks)
#               ui_present(c)          # blit the frame
#       ui_fini(c)
#       return 0
#   Aoxn run hello_ui.ax -l user32 -l gdi32
#
# Platform status: Windows backend complete. On other systems ui_init prints
# a note and returns a closed context, so programs still compile and exit
# cleanly (the dead Win32 branch is constant-folded away; POSIX builds of UI
# programs need the default O1+ pipeline to drop the unreferenced symbols).
# See docs/ui.md for the widget reference and roadmap (X11/Cocoa, text input).

import "../stdlib/stdlib.ax"

# ---- C ABI surface (kernel32 + CRT are linked by default; -l user32 -l gdi32) ----

extern def LoadLibraryA(name: string) -> int
extern def GetProcAddress(mod: int, name: string) -> int
extern def GetModuleHandleW(name: int) -> int
