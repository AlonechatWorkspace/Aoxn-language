extern def CreateFontW(h: int, w: int, esc: int, ori: int, weight: int, italic: int, underline: int, strike: int, charset: int, outp: int, clipp: int, qual: int, pitch: int, face: string) -> int

# ---- values ----

# COLORREF (0x00BBGGRR) without bitwise ops
def ui_rgb(r: int, g: int, b: int) -> int:
    return r + g * 256 + b * 65536

# stable widget id from position (x, y < 2^32, injective for sane layouts)
def ui_wid_id(x: int, y: int) -> int:
    return x * 4294967296 + y

# read a little-endian i32 at address p (handles negative POINT/RECT fields;
# no bitwise ops, so bytes are assembled arithmetically)
def i32_at(p: int) -> int:
    u = load_u8(p, 0) + load_u8(p, 1) * 256 + load_u8(p, 2) * 65536 + load_u8(p, 3) * 16777216
    if u >= 2147483648:
        return u - 4294967296
    return u

# UTF-8 -> UTF-16LE (surrogates included). Writes at p, returns BYTE count.
def utf16_write(s: string, p: int) -> int:
    i = 0
    n = 0
    while i < len(s):
        b = load_u8(s, i)
        if b < 128:
            cp = b
            i = i + 1
        elif b < 224:
            cp = (b % 32) * 64 + load_u8(s, i + 1) % 64
            i = i + 2
        elif b < 240:
            cp = (b % 16) * 4096 + (load_u8(s, i + 1) % 64) * 64 + load_u8(s, i + 2) % 64
            i = i + 3
        else:
            cp = (b % 8) * 262144 + (load_u8(s, i + 1) % 64) * 4096 + (load_u8(s, i + 2) % 64) * 64 + load_u8(s, i + 3) % 64
            i = i + 4
        if cp >= 65536:
            v = cp - 65536
            hi = v / 1024 + 55296
            lo = v % 1024 + 56320
            store_u8(p, n, hi % 256)
            store_u8(p, n + 1, hi / 256)
            store_u8(p, n + 2, lo % 256)
            store_u8(p, n + 3, lo / 256)
            n = n + 4
        else:
            store_u8(p, n, cp % 256)
            store_u8(p, n + 1, cp / 256)
            n = n + 2
    return n

# one-shot UTF-16 NUL-terminated buffer (init-time use; caller frees)
def ui_utf16(s: string) -> int:
    p = malloc(len(s) * 2 + 2)
    n = utf16_write(s, p)
    store_u8(p, n, 0)
    store_u8(p, n + 1, 0)
    return p

struct TextSize:
    w: int
    h: int

struct Palette:
    bg: int
    panel: int
    text: int
    text_dim: int
    widget: int
    widget_hover: int
    widget_down: int
    border: int
    accent: int
    groove: int

def light_palette() -> Palette:
    return Palette(
        bg=ui_rgb(240, 240, 240),
        panel=ui_rgb(245, 245, 245),
        text=ui_rgb(30, 30, 30),
        text_dim=ui_rgb(110, 110, 110),
        widget=ui_rgb(225, 225, 225),
        widget_hover=ui_rgb(214, 232, 250),
        widget_down=ui_rgb(191, 222, 250),
        border=ui_rgb(138, 138, 138),
        accent=ui_rgb(0, 120, 215),
        groove=ui_rgb(204, 204, 204))

def dark_palette() -> Palette:
    return Palette(
        bg=ui_rgb(32, 32, 32),
        panel=ui_rgb(43, 43, 43),
        text=ui_rgb(235, 235, 235),
        text_dim=ui_rgb(150, 150, 150),
        widget=ui_rgb(55, 55, 55),
        widget_hover=ui_rgb(66, 76, 88),
        widget_down=ui_rgb(78, 98, 118),
        border=ui_rgb(92, 92, 92),
        accent=ui_rgb(0, 120, 212),
        groove=ui_rgb(62, 62, 62))

# The UI context is a plain value: fields are inputs to widgets, and ui_frame
# returns the updated copy (write-back style, like everything in stdlib).
# `st` is a pointer to a heap block whose layout is fixed:
#   0        active widget id (press claim, one drag at a time)
#   1..3     frame arena: base ptr / bump offset / capacity
#   4..259   key_cur[vk]  (0/1, GetAsyncKeyState snapshot)
#   260..515 key_prev[vk] (previous frame's snapshot, for edge detection)
#   516..525 palette: bg panel text text_dim widget widget_hover widget_down
#            border accent groove
struct UI:
    hwnd: int
    win_dc: int
    mem_dc: int
    bmp: int
    old_bmp: int
    font: int
    font_big: int
    msg: int
    pt: int
    rect: int
    st: int
    w: int
    h: int
    mx: int
    my: int
    dn: bool
    dn_prev: bool
    dn2: bool
    open: bool
    frames: int
    cap_ms: int

# ---- heap state + frame arena ----

def st_get(c: UI, i: int) -> int:
    return load_i64(c.st + i * 8)

def st_set(c: UI, i: int, v: int):
    store_i64(c.st + i * 8, v)

def ui_palette_set(c: UI, p: Palette):
    st_set(c, 516, p.bg)
    st_set(c, 517, p.panel)
    st_set(c, 518, p.text)
    st_set(c, 519, p.text_dim)
    st_set(c, 520, p.widget)
    st_set(c, 521, p.widget_hover)
    st_set(c, 522, p.widget_down)
    st_set(c, 523, p.border)
    st_set(c, 524, p.accent)
    st_set(c, 525, p.groove)

def ui_palette_get(c: UI) -> Palette:
    return Palette(
        bg=st_get(c, 516),
        panel=st_get(c, 517),
        text=st_get(c, 518),
        text_dim=st_get(c, 519),
        widget=st_get(c, 520),
        widget_hover=st_get(c, 521),
        widget_down=st_get(c, 522),
        border=st_get(c, 523),
        accent=st_get(c, 524),
        groove=st_get(c, 525))

# UTF-16 from the per-frame bump arena (reset in ui_frame): steady-state
# frames allocate nothing. Escapes to malloc when the frame needs more than
# the arena holds (rare; that buffer intentionally leaks, like concat).
def utf16f(c: UI, s: string) -> int:
    need = len(s) * 2 + 2
    off = st_get(c, 2)
    if st_get(c, 1) == 0 or off + need > st_get(c, 3):
        p = malloc(need)
        utf16_write(s, p)
        return p
    p = st_get(c, 1) + off
    nb = utf16_write(s, p)
    store_u8(p, nb, 0)
    store_u8(p, nb + 1, 0)
    st_set(c, 2, off + nb + 2)
    return p

# decimal int -> NUL-terminated ASCII in the frame arena (pointer to first
# digit). Used by ui_label_int so hot paths never build Aoxn strings.
def itoa10(c: UI, v: int) -> int:
    if st_get(c, 2) + 24 > st_get(c, 3):
        return ui_utf16(str(v))
    p = st_get(c, 1) + st_get(c, 2)
    neg = False
    if v < 0:
        neg = True
        v = -v
    store_u8(p, 21, 0)
    q = 21
    if v == 0:
        q = 20
        store_u8(p, 20, 48)
    while v > 0:
        q = q - 1
        store_u8(p, q, 48 + v % 10)
        v = v / 10
    if neg:
        q = q - 1
        store_u8(p, q, 45)
    st_set(c, 2, st_get(c, 2) + 24)
    return p + q

# ---- input queries (pure, work on every platform) ----

def ui_mouse_in(c: UI, x: int, y: int, w: int, h: int) -> bool:
    return c.mx >= x and c.mx < x + w and c.my >= y and c.my < y + h

def ui_key_down(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1

# true only on the frame the key went down
def ui_key_pressed(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1 and st_get(c, 260 + vk) == 0

# ---- drawing primitives ----

# stock objects used below: NULL_BRUSH=5 NULL_PEN=8 DC_BRUSH=18 DC_PEN=20
def ui_fill_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(18))
    SetDCBrushColor(c.mem_dc, color)
    SelectObject(c.mem_dc, GetStockObject(8))
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def ui_frame_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(20))
    SetDCPenColor(c.mem_dc, color)
    SelectObject(c.mem_dc, GetStockObject(5))
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def round_fill(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    SelectObject(c.mem_dc, GetStockObject(18))
    SetDCBrushColor(c.mem_dc, fill)
    SelectObject(c.mem_dc, GetStockObject(20))
    SetDCPenColor(c.mem_dc, border)
    RoundRect(c.mem_dc, x, y, x + w, y + h, 8, 8)

def ui_draw_line(c: UI, x1: int, y1: int, x2: int, y2: int, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, GetStockObject(20))
    SetDCPenColor(c.mem_dc, color)
    MoveToEx(c.mem_dc, x1, y1, 0)
    LineTo(c.mem_dc, x2, y2)

def ui_draw_text(c: UI, x: int, y: int, s: string, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, c.font)
    SetTextColor(c.mem_dc, color)
    p = utf16f(c, s)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def ui_draw_text_big(c: UI, x: int, y: int, s: string, color: int):
    if target_os() != "windows":
        return
    SelectObject(c.mem_dc, c.font_big)
    SetTextColor(c.mem_dc, color)
    p = utf16f(c, s)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def ui_measure(c: UI, s: string) -> TextSize:
    if target_os() != "windows":
        return TextSize(w=0, h=0)
    p = utf16f(c, s)
    n = lstrlenW(as_string(p))
    GetTextExtentPoint32W(c.mem_dc, as_string(p), n, c.rect)
    v = load_i64(c.rect)
    return TextSize(w=v % 4294967296, h=v / 4294967296)

# ---- widgets (immediate mode: call every frame, own the state yourself) ----

def ui_button(c: UI, x: int, y: int, w: int, h: int, s: string) -> bool:
    if target_os() != "windows":
        return False
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x, y, w, h)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
    clicked = False
    if act == id and c.dn_prev and not c.dn:
        if hot:
            clicked = True
        st_set(c, 0, 0)
        act = 0
    pal = ui_palette_get(c)
    face = pal.widget
    if hot and act == id:
        face = pal.widget_down
    elif hot:
        face = pal.widget_hover
    pen = pal.border
    if hot:
        pen = pal.accent
    ts = ui_measure(c, s)
    tx = x + (w - ts.w) / 2
    ty = y + (h - ts.h) / 2
    if hot and act == id:
        ty = ty + 1
    round_fill(c, x, y, w, h, face, pen)
    ui_draw_text(c, tx, ty, s, pal.text)
    return clicked

def ui_label(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text)

def ui_label_dim(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text_dim)

# label + decimal int without building a concatenated string per frame
def ui_label_int(c: UI, x: int, y: int, prefix: string, v: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, prefix, pal.text)
    ts = ui_measure(c, prefix)
    p = itoa10(c, v)
    ui_draw_text(c, x + ts.w, y, as_string(p), pal.text)

def ui_title(c: UI, x: int, y: int, s: string):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_draw_text_big(c, x, y, s, pal.text)

def ui_checkbox(c: UI, x: int, y: int, s: string, checked: bool) -> bool:
    if target_os() != "windows":
        return checked
    result = checked
    ts = ui_measure(c, s)
    hot = ui_mouse_in(c, x, y, 22 + ts.w, 20)
    id = ui_wid_id(x, y)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = not checked
        st_set(c, 0, 0)
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y + 2, 15, 15, pal.panel)
    ui_frame_rect(c, x, y + 2, 15, 15, pal.border)
    if checked:
        ui_draw_line(c, x + 3, y + 9, x + 6, y + 13, pal.accent)
        ui_draw_line(c, x + 6, y + 13, x + 12, y + 4, pal.accent)
    ui_draw_text(c, x + 22, y, s, pal.text)
    return result

# horizontal slider, 20 px tall; returns the (possibly dragged) value
def ui_slider(c: UI, x: int, y: int, w: int, value: int, vmin: int, vmax: int) -> int:
    if target_os() != "windows":
        return value
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x - 8, y - 4, w + 16, 28)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
    if act == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
        act = 0
    if act == id and c.dn:
        span = w - 10
        if span < 1:
            span = 1
        value = vmin + (c.mx - (x + 5)) * (vmax - vmin) / span
    if value < vmin:
        value = vmin
    if value > vmax:
        value = vmax
    pal = ui_palette_get(c)
    ui_fill_rect(c, x + 4, y + 9, w - 8, 4, pal.groove)
    rng = vmax - vmin
    if rng < 1:
        rng = 1
    chunk = (value - vmin) * (w - 10) / rng
    if chunk < 0:
        chunk = 0
    if chunk > w - 10:
        chunk = w - 10
    if chunk > 0:
        ui_fill_rect(c, x + 4, y + 9, chunk, 4, pal.accent)
    round_fill(c, x + chunk, y + 1, 10, 18, pal.widget, pal.border)
    return value

def ui_progress(c: UI, x: int, y: int, w: int, value: int, vmax: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 8, pal.groove)
    top = vmax
    if top < 1:
        top = 1
    cw = value * w / top
    if cw < 0:
        cw = 0
    if cw > w:
        cw = w
    if cw > 0:
        ui_fill_rect(c, x, y, cw, 8, pal.accent)

def ui_separator(c: UI, x: int, y: int, w: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 1, pal.border)

def ui_panel(c: UI, x: int, y: int, w: int, h: int):
    if target_os() != "windows":
        return
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, h, pal.panel)

# ---- core: lifecycle ----

def ui_init(title: string, w: int, h: int) -> UI:
    c = UI(hwnd=0, win_dc=0, mem_dc=0, bmp=0, old_bmp=0, font=0, font_big=0,
        msg=0, pt=0, rect=0, st=0, w=0, h=0, mx=-1, my=-1, dn=False,
        dn_prev=False, dn2=False, open=False, frames=0, cap_ms=15)
    if target_os() != "windows":
        print("ui: no backend for this platform yet (see docs/ui.md) — window stays closed")
        return c
    # exe files are console-subsystem (the compiler links the default CRT
    # entry); a GUI app must not keep that console, so detach from it. When
    # stdout is a pipe (tests, CI) this is harmless: handles stay valid.
    FreeConsole()
    return init_win(c, title, w, h)

# window class style: CS_HREDRAW(2) + CS_VREDRAW(1) + CS_OWNDC(32)
def init_win(c: UI, title: string, w: int, h: int) -> UI:
    SetProcessDPIAware()
    st = malloc(4208)
    fill_zero(st, 4208)
    c.st = st
    st_set(c, 1, malloc(65536))
    st_set(c, 2, 0)
    st_set(c, 3, 65536)
    ui_palette_set(c, light_palette())
    c.msg = malloc(48)
    fill_zero(c.msg, 48)
    c.pt = malloc(8)
    c.rect = malloc(16)
    # WNDCLASSW (x64, 72 bytes): style, wndproc, extras, instance, cursor,
    # background brush = NULL (no erase flicker), class name
    cls = ui_utf16("AoxnUI")
    wc = malloc(72)
    fill_zero(wc, 72)
    user32 = LoadLibraryA("user32.dll")
    store_i64(wc, 35)
    store_i64(wc + 8, GetProcAddress(user32, "DefWindowProcW"))
    store_i64(wc + 24, GetModuleHandleW(0))
    store_i64(wc + 40, LoadCursorW(0, 32512))
    store_i64(wc + 64, cls)
    RegisterClassW(wc)
    # size the window so the CLIENT area is exactly w x h
    store_i64(c.rect, 0)
    store_i64(c.rect + 8, w)
    AdjustWindowRect(c.rect, 13565952, 0)
    ww = i32_at(c.rect + 8) - i32_at(c.rect)
    wh = i32_at(c.rect + 12) - i32_at(c.rect + 4)
    t16 = ui_utf16(title)
    # CW_USEDEFAULT position = -2147483648; WS_OVERLAPPEDWINDOW = 13565952
    hwnd = CreateWindowExW(0, as_string(cls), as_string(t16), 13565952,
        -2147483648, -2147483648, ww, wh, 0, 0, load_i64(wc + 24), 0)
    free(wc)
    free(cls)
    free(t16)
    c.hwnd = hwnd
    c.open = hwnd != 0
    if not c.open:
        return c
    c.win_dc = GetDC(hwnd)
    c.mem_dc = CreateCompatibleDC(c.win_dc)
    c.bmp = CreateCompatibleBitmap(c.win_dc, w, h)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    c.font = make_font(-16, 400)
    c.font_big = make_font(-26, 700)
    SetBkMode(c.mem_dc, 1)
    SetTextAlign(c.mem_dc, 0)
    GetClientRect(hwnd, c.rect)
    c.w = i32_at(c.rect + 8)
    c.h = i32_at(c.rect + 12)
    pal = ui_palette_get(c)
    ui_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    ui_present(c)
    ShowWindow(hwnd, 5)
    return c

def make_font(px: int, weight: int) -> int:
    face = ui_utf16("Segoe UI")
    f = CreateFontW(px, 0, 0, 0, weight, 0, 0, 0, 1, 0, 0, 5, 0, as_string(face))
    free(face)
    return f

def resize_bitmap(c: UI, nw: int, nh: int) -> UI:
    if nw < 1 or nh < 1:
        return c
    SelectObject(c.mem_dc, c.old_bmp)
    DeleteObject(c.bmp)
    c.w = nw
    c.h = nh
    c.bmp = CreateCompatibleBitmap(c.win_dc, c.w, c.h)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    return c

# pump messages, sample input, reset the frame arena, fill the background.
# Returns the updated context; check c.open afterwards.
def ui_frame(c: UI) -> UI:
    if target_os() != "windows":
        return c
    return frame_win(c)

def frame_win(c: UI) -> UI:
    # idle cap: wake on any input or after cap_ms (~66 fps default)
    MsgWaitForMultipleObjects(0, 0, 1, c.cap_ms, 1279)
    # drain pending messages; DefWindowProc validates paint and handles close
    while PeekMessageW(c.msg, 0, 0, 0, 1) != 0:
        TranslateMessage(c.msg)
        DispatchMessageW(c.msg)
    c.dn_prev = c.dn
    c.open = IsWindow(c.hwnd) != 0
    if not c.open:
        return c
    GetCursorPos(c.pt)
    ScreenToClient(c.hwnd, c.pt)
    c.mx = i32_at(c.pt)
    c.my = i32_at(c.pt + 4)
    if GetForegroundWindow() == c.hwnd:
        # GetAsyncKeyState returns a SHORT: bit 15 (32768) = down
        c.dn = GetAsyncKeyState(1) / 32768 == 1
        c.dn2 = GetAsyncKeyState(2) / 32768 == 1
    else:
        c.dn = False
        c.dn2 = False
    i = 0
    while i < 256:
        st_set(c, 260 + i, st_get(c, 4 + i))
        st_set(c, 4 + i, 0)
        i = i + 1
    vk = 1
    while vk < 256:
        if GetAsyncKeyState(vk) / 32768 == 1:
            st_set(c, 4 + vk, 1)
        vk = vk + 1
    GetClientRect(c.hwnd, c.rect)
    nw = i32_at(c.rect + 8)
    nh = i32_at(c.rect + 12)
    if nw != c.w or nh != c.h:
        c = resize_bitmap(c, nw, nh)
    st_set(c, 2, 0)
    pal = ui_palette_get(c)
    ui_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    c.frames = c.frames + 1
    return c

def ui_present(c: UI):
    if target_os() != "windows":
        return
    if c.win_dc == 0 or c.mem_dc == 0:
        return
    BitBlt(c.win_dc, 0, 0, c.w, c.h, c.mem_dc, 0, 0, 13369376)

def ui_close(c: UI):
    if target_os() != "windows":
        return
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)

def ui_fini(c: UI):
    if target_os() != "windows":
        return
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)
    if c.mem_dc != 0:
        SelectObject(c.mem_dc, c.old_bmp)
        if c.bmp != 0:
            DeleteObject(c.bmp)
        DeleteDC(c.mem_dc)
    if c.win_dc != 0:
        ReleaseDC(c.hwnd, c.win_dc)
    if c.font != 0:
        DeleteObject(c.font)
    if c.font_big != 0:
        DeleteObject(c.font_big)
    if c.st != 0:
        arena = st_get(c, 1)
        if arena != 0:
            free(arena)
        free(c.st)
    if c.msg != 0:
        free(c.msg)
    if c.pt != 0:
        free(c.pt)
    if c.rect != 0:
        free(c.rect)

def ui_alert(text: string, caption: string):
    if target_os() != "windows":
        print(text)
        return
    t16 = ui_utf16(text)
    c16 = ui_utf16(caption)
    MessageBoxW(0, as_string(t16), as_string(c16), 0)
