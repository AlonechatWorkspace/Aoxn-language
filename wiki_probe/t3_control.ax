def classify(n: int) -> string:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

def main() -> int:
    print(classify(-3))
    i = 0
    while i < 3:
        print(f"while {i}")
        i = i + 1
    for k in range(3):
        if k == 1:
            continue
        print(f"range {k}")
    for k in range(10, 0, -3):
        print(f"step {k}")
    return 0
