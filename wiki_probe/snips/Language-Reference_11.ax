def main() -> int:
    a = [10, 20, 30]                    # [int; 3]
    xs: [int; 4] = [1, 2, 3, 4]         # annotated
    m: [[int; 2]; 2] = [[1, 2], [3, 4]] # nested
    grid: [int; 6] = [0] * 6            # replication
