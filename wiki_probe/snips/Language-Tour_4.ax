def main() -> int:
    a = [10, 20, 30]                    # 推断为 [int; 3]
    xs: [int; 4] = [1, 2, 3, 4]         # 显式标注
    m: [[int; 2]; 2] = [[1, 2], [3, 4]] # 嵌套数组
    grid: [int; 6] = [0] * 6            # Python 式复制（运行时填充）
    a[1] = 99                           # 元素赋值
    print(len(a))                       # 3，编译期常量
    print(f"{a[0]} {a[1]} {m[1][0]} {grid[5]}")
    b = a                               # 值语义：整份拷贝
    b[0] = -1                           # 不会影响 a
    print(f"{a[0]} {b[0]}")
    return 0
