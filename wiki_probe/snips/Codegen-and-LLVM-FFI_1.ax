struct Big:
    a: [int; 4]
    s: string

def pick(x: int, y: int) -> bool:
    return x > 0 and y > 0 or x == y

def rep() -> [int; 3]:
    return [7] * 3

def main() -> int:
    print(pick(1, 2))
    b = Big(a=[1, 2, 3, 4], s="hi")
    print(b.a[2])
    r = rep()
    print(len(r))
    total = 0
    for v in r:
        total = total + v
    print(total)
    print(load_u8("abc", 1))
    store_u8(1024, 0, 65)
    print(as_ptr("xyz"))
    print(str(3.5))
    print(str(True))
    print(f"n={3} s={True}")
    return 0
