import "../../stdlib/stdlib.ax"

def first[T, N](arr: [T; N]) -> T:
    return arr[0]

def main() -> int:
    print(first([7, 8, 9]))          # T = int,   N = 3
    print(first(["b", "a"]))         # T = string, N = 2
    s = sort([5, 3, 8, 1])           # stdlib 的泛型排序
    print(f"{s[0]} {s[3]}")
    return 0
