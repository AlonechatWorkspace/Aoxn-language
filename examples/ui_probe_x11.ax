import * from "../stdlib/ui_x11.ax"

# Aoxn UI - X11 backend smoke probe.
#
# Used by CI (.github/workflows/ci.yml) on Linux under Xvfb: it opens a real
# window on a virtual X server, draws a few widgets for 30 frames, closes
# itself and reports. It is the check that the X11 backend LINKS (the
# clang-free unit tests stop at C emission and never resolve a symbol) and
# that its event loop honours plat_close.
#
#   xvfb-run -a aoxn run examples/ui_probe_x11.ax -l X11 -l Xft
#
# Prints "ui-x11-ok frames=N" on success. Exits 0 without a display so the
# step can tell "no server" apart from "backend is broken".
#
# The x11_trace() calls write to stderr via system(), NOT print(): stdout is
# fully buffered when piped, so a fault would discard every buffered line
# and the run would look like it produced nothing at all. stderr is
# unbuffered, so the last trace printed names the call that faulted.
# Temporary diagnostics - remove once the X11 path is stable.

def main() -> int:
    x11_trace("probe: calling ui_init")
    c = ui_init("aoxn x11 probe", 320, 200)
    x11_trace("probe: ui_init returned")
    if not c.open:
        print("ui-x11: no display")
        return 0
    n = 0
    while c.open:
        x11_trace("probe: frame enter")
        c = ui_frame(c)
        x11_trace("probe: ui_frame done")
        if not c.open:
            break
        n = n + 1
        if ui_button(c, 12, 40, 100, 30, "noop"):
            print("ui-x11-click")
        x11_trace("probe: button done")
        ui_label(c, 12, 12, "x11 backend ok")
        x11_trace("probe: label done")
        ui_present(c)
        x11_trace("probe: present done")
        if n >= 30:
            ui_close(c)
    x11_trace("probe: loop exited")
    ui_fini(c)
    x11_trace("probe: ui_fini done")
    print("ui-x11-ok frames=" + str(n))
    return 0
