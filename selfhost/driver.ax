# Aoxn self-hosted driver, written in Aoxn (self-hosting stage 4).
#
# Closes the loop: source file -> import-aware load -> strict type check ->
# C-text codegen -> `clang -c` object -> clang link -> executable. All stages
# are implemented in Aoxn (selfhost/*.ax); the driver only orchestrates them
# and shells out to clang via the stdlib `system` binding.
#
# Since v0.29.0 the self-hosted compiler shares the Rust compiler's backend
# shape: it emits ISO C99 text (codegen.ax) and lets clang produce the native
# object, so the LLVM-C API is no longer part of the pipeline at all.
#
# Paths are taken as given and resolved against the current directory.

import * from "../stdlib/stdlib.ax"
import * from "./lexer.ax"
import * from "./parser.ax"
import * from "./typecheck.ax"
import * from "./load.ax"
import * from "./codegen.ax"
struct DriverState:
    err: int
    errmsg: string

def driver_err(d: DriverState, msg: string) -> DriverState:
    if d.err == 0:
        d.err = 1
        d.errmsg = msg
    return d

# platform artifact suffix: ".exe" on Windows, "" elsewhere
def exe_suffix() -> string:
    if target_os() == "windows":
        return ".exe"
    return ""

def compile_file(src_path: string, obj_path: string, exe_path: string) -> DriverState:
    d = DriverState(err=0, errmsg="")
    ls = load_program(src_path)
    if ls.err == 1:
        return driver_err(d, ls.errmsg)
    c = checker_state()
    c.p = ls.p
    c = check_all(c)
    if c.err == 1:
        return driver_err(d, c.errmsg)
    g = gen_new(c)
    g = gen_program(g)
    if g.err == 1:
        return driver_err(d, g.errmsg)
    g = gen_emit_object(g, obj_path)
    if g.err == 1:
        return driver_err(d, g.errmsg)
    # /STACK is a Windows link.exe flag; POSIX main-thread stacks are 8MB
    # already (RLIMIT_STACK on Linux, fixed on macOS).
    if target_os() == "windows":
        cmd = "clang " + obj_path + " -o " + exe_path + " -Wl,/STACK:8388608"
    else:
        # -lm: C math (fmod/sqrt/...) is a separate library on POSIX (the CRT
        # link covers it on Windows)
        cmd = "clang " + obj_path + " -o " + exe_path + " -lm"
    rc = system(cmd)
    if rc != 0:
        return driver_err(d, "link failed (exit " + str(rc) + "): " + cmd)
    return d

# the self-hosted `aoxn c`: load -> check -> codegen, write the generated C
# text to c_path (no object, no link)
def emit_c(src_path: string, c_path: string) -> DriverState:
    d = DriverState(err=0, errmsg="")
    ls = load_program(src_path)
    if ls.err == 1:
        return driver_err(d, ls.errmsg)
    c = checker_state()
    c.p = ls.p
    c = check_all(c)
    if c.err == 1:
        return driver_err(d, c.errmsg)
    g = gen_new(c)
    g = gen_program(g)
    if g.err == 1:
        return driver_err(d, g.errmsg)
    text = gen_c_text(g)
    if text == "":
        return driver_err(d, "codegen produced no C text")
    if not write_file(c_path, text):
        return driver_err(d, "cannot write '" + c_path + "'")
    return d
