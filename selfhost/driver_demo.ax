# Self-hosting driver demo: the Aoxn-written compiler compiles hello.ax to a
# native executable (C-text codegen + clang). Run from a directory containing
# hello.ax; clang must be on PATH (both stages shell out via system()).
import * from "./driver.ax"
def main() -> int:
    d = compile_file("hello.ax", "selfhost_hello.obj", "selfhost_hello" + exe_suffix())
    if d.err == 1:
        print("DRIVER ERROR: " + d.errmsg)
        return 1
    print("driver OK")
    return 0
