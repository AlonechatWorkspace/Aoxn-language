# Self-hosting stage-4 first slice: the Aoxn code generator (written in Aoxn)
# runs after the self-hosted checker and emits a native object file via the
# LLVM-C API. Run from a writable directory: it writes selfhost_out.obj.
#
# Covered: int/float/bool/string functions and locals, arithmetic +
# comparisons, if/else, while, for-range, break/continue, direct and
# monomorphized calls, print(int/float/bool/string), len/str builtins,
# string + and comparisons, f-strings, structs (construction, field r/w,
# value-semantics copy, struct params and returns).
import * from "../stdlib/stdlib.ax"
import * from "./lexer.ax"
import * from "./parser.ax"
import * from "./typecheck.ax"
import * from "./codegen.ax"
def main() -> int:
    src = "def twice[T](x: T) -> T:\n    return x + x\n\ndef add(a: int, b: int) -> int:\n    return a + b\n\ndef fact(n: int) -> int:\n    if n <= 1:\n        return 1\n    return n * fact(n - 1)\n\ndef greet(name: string) -> string:\n    return \"hello, \" + name + \"!\"\n\ndef half(x: float) -> float:\n    return x / 2.0\n\nstruct Point:\n    x: int\n    y: int\n\ndef dist2(a: Point, b: Point) -> int:\n    dx = a.x - b.x\n    dy = a.y - b.y\n    return dx * dx + dy * dy\n\ndef origin() -> Point:\n    return Point(x=0, y=0)\n\ndef main() -> int:\n    t = twice(3)\n    for i in range(1, 6):\n        t = t + i * i\n    while t > 50:\n        t = t - 10\n    ok = t == 41\n    print(t)\n    print(fact(4))\n    print(t > 40)\n    print(ok)\n    print(-t)\n    msg = greet(\"aoxn\")\n    print(msg)\n    print(len(msg))\n    print(msg == \"hello, aoxn!\")\n    print(\"n=\" + str(t - 36))\n    print(f\"n squared = {(t - 36) * (t - 36)}\")\n    f = 1.5\n    g2 = f + 2.5\n    print(g2)\n    print(half(g2))\n    print(f < 2.0)\n    print(f == 1.5)\n    print(-f)\n    print(\"f=\" + str(f))\n    print(f\"half f = {half(f)}\")\n    p = Point(x=3, y=4)\n    q = Point(x=0, y=0)\n    print(dist2(p, q))\n    r = origin()\n    print(r.x)\n    p.x = 10\n    print(p.x)\n    s = p\n    s.y = 7\n    print(p.y)\n    print(s.y)\n    return add(t, fact(4)) % 100\n"
    c = checker_new(lex_state_new(src))
    c = check_all(c)
    if c.err == 1:
        print("CHECK ERROR: " + c.errmsg)
        return 1
    g = gen_new(c)
    g = gen_program(g)
    if g.err == 1:
        print("CODEGEN ERROR: " + g.errmsg)
        return 1
    g = gen_emit_object(g, "selfhost_out.obj")
    if g.err == 1:
        print("EMIT ERROR: " + g.errmsg)
        return 1
    gen_dispose(g)
    print("codegen OK")
    return 0
