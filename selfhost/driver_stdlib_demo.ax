# Self-hosting driver demo (stdlib slice): the Aoxn-written compiler compiles
# a program that imports the standard library (arrays, generic sort/search,
# Vec/raw memory, short-circuit logic) to a native executable, and writes the
# generated C text next to it (fixed-point comparison material). Run from a
# directory containing stdlib_use.ax; clang must be on PATH.
import * from "./driver.ax"
def main() -> int:
    d = compile_file("stdlib_use.ax", "selfhost_stdlib.obj", "selfhost_stdlib" + exe_suffix())
    if d.err == 1:
        print("DRIVER ERROR: " + d.errmsg)
        return 1
    ct = emit_c("stdlib_use.ax", "stdlib_use.c")
    if ct.err == 1:
        print("C ERROR: " + ct.errmsg)
        return 1
    print("driver OK")
    return 0
