# Self-hosting driver demo (stdlib slice): the Aoxn-written compiler compiles
# a program that imports the standard library (arrays, generic sort/search,
# Vec/raw memory, short-circuit logic) to a native executable. Run from a
# directory containing stdlib_use.ax; clang must be on PATH.
#   aoxn run selfhost\driver_stdlib_demo.ax -l LLVM-C -L "C:\Program Files\LLVM\lib"
import "driver.ax"

def main() -> int:
    d = compile_file("stdlib_use.ax", "selfhost_stdlib.obj", "selfhost_stdlib.exe")
    if d.err == 1:
        print("DRIVER ERROR: " + d.errmsg)
        return 1
    print("driver OK")
    return 0
