# Self-compilation demo (fixed point): the Aoxn-written driver compiles the
# ENTIRE self-hosting compiler (driver + codegen + typecheck + parser + lexer
# + loader + stdlib) into target/selfhost_stage2(.exe). Run from the repo root;
# run stage2 from a directory with stdlib_use.ax to get the compiler's product.
# clang must be on PATH; the LLVM-C lib dir and the artifact suffix follow
# target_os() (AOXN_LLVM_LIBDIR overrides the lib dir if the set is unset).
import * from "./driver.ax"
def llvm_libdir() -> string:
    if target_os() == "windows":
        return "C:/Program Files/LLVM/lib"
    if target_os() == "macos":
        return "/opt/homebrew/opt/llvm/lib"
    return "/usr/lib/llvm-18/lib"

def exe_ext() -> string:
    if target_os() == "windows":
        return ".exe"
    return ""

def main() -> int:
    obj = "target/selfhost_stage2.obj"
    exe = "target/selfhost_stage2" + exe_ext()
    d = compile_file_libs("selfhost/driver_stdlib_demo.ax", obj, exe, "LLVM-C", llvm_libdir())
    if d.err == 1:
        print("SELFCOMPILE ERROR: " + d.errmsg)
        return 1
    print("selfcompile OK")
    return 0
