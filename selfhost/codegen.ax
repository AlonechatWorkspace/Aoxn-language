extern def LLVMStructSetBody(ty: int, fields: int, n: int, packed: int)
extern def LLVMGetTypeByName(m: int, name: string) -> int
extern def LLVMSizeOf(ty: int) -> int
extern def LLVMBuildGlobalStringPtr(b: int, s: string, name: string) -> int
extern def LLVMPointerTypeInContext(ctx: int, addrspace: int) -> int
extern def LLVMBuildPhi(b: int, ty: int, name: string) -> int
extern def LLVMAddIncoming(phi: int, vals: int, bbs: int, n: int)
extern def strlen(s: string) -> int
extern def strcmp(a: string, b: string) -> int
extern def LLVMGetParam(f: int, i: int) -> int
extern def LLVMGetNamedFunction(m: int, name: string) -> int
extern def LLVMInitializeX86TargetInfo()
extern def LLVMInitializeX86Target()
extern def LLVMInitializeX86TargetMC()
extern def LLVMInitializeX86AsmPrinter()
# AArch64 is registered alongside X86 (they do not conflict: the target is
# selected by the triple). Without these, Apple Silicon hosts fail with
# "no available targets are compatible with triple arm64-apple-darwin...".
extern def LLVMInitializeAArch64TargetInfo()
extern def LLVMInitializeAArch64Target()
extern def LLVMInitializeAArch64TargetMC()
extern def LLVMInitializeAArch64AsmPrinter()
extern def LLVMGetDefaultTargetTriple() -> string
extern def LLVMSetTarget(m: int, triple: string)
extern def LLVMGetTargetFromTriple(triple: string, target: int, err: int) -> int
extern def LLVMCreateTargetMachine(t: int, triple: string, cpu: string, feat: string, level: int, reloc: int, cmodel: int) -> int
extern def LLVMDisposeTargetMachine(tm: int)
extern def LLVMCreateTargetDataLayout(tm: int) -> int
extern def LLVMSetModuleDataLayout(m: int, dl: int)
extern def LLVMCreatePassBuilderOptions() -> int
extern def LLVMRunPasses(m: int, passes: string, tm: int, opts: int) -> int
extern def LLVMDisposePassBuilderOptions(o: int)
extern def LLVMTargetMachineEmitToFile(tm: int, m: int, path: string, codegen: int, err: int) -> int
extern def LLVMVerifyModule(m: int, mode: int, msg: int) -> int
extern def LLVMPrintModuleToString(m: int) -> string
extern def LLVMArrayType(elem: int, count: int) -> int
extern def LLVMBuildIntToPtr(b: int, v: int, ty: int, name: string) -> int
extern def LLVMBuildPtrToInt(b: int, v: int, ty: int, name: string) -> int
extern def LLVMBuildZExt(b: int, v: int, ty: int, name: string) -> int

# LLVMCodeGenFileType: assembly = 0, object = 1; pass levels: aggressive = 3
def CG_OBJECT() -> int:
    return 1

def CG_O3() -> int:
    return 3

# LLVMRelocMode: default = 0, PIC = 2. Linux/macOS link PIE executables by
# default, which requires position-independent code; Windows COFF uses the
# default (mirrors `platform::is_windows()` in the Rust compiler).
def CG_RELOC() -> int:
    if target_os() == "windows":
        return 0
    return 2

# LLVMIntPredicate
def ICMP_EQ() -> int:
    return 32

def ICMP_NE() -> int:
    return 33

def ICMP_SGT() -> int:
    return 38

def ICMP_SGE() -> int:
    return 39

def ICMP_SLT() -> int:
    return 40

def ICMP_SLE() -> int:
    return 41

# LLVMRealPredicate (ordered)
def REAL_OEQ() -> int:
    return 1

def REAL_OGT() -> int:
    return 2

def REAL_OGE() -> int:
    return 3

def REAL_OLT() -> int:
    return 4

def REAL_OLE() -> int:
    return 5

def REAL_UNE() -> int:
    return 6

# expression result kinds
def RK_INT() -> int:
    return 0

def RK_BOOL() -> int:
    return 1

def RK_VOID() -> int:
    return 2

def RK_STR() -> int:
    return 3

def RK_FLOAT() -> int:
    return 4

def RK_STRUCT() -> int:
    return 5

# ---- generator state ----

struct Gen:
    c: CState
    ctx: int
    module: int
    builder: int
    i1: int
    i8: int
    i32: int
    i64: int
    f64: int
    ty_void: int
    ptr: int
    printf: int
    printf_ty: int
    snprintf: int
    snprintf_ty: int
    rt_strlen: int
    rt_strlen_ty: int
    rt_strcmp: int
    rt_strcmp_ty: int
    rt_malloc: int
    rt_malloc_ty: int
    rt_memcpy: int
    rt_memcpy_ty: int
    fn_ref: Vec        # fni -> LLVMValueRef
    fn_llty: Vec       # fni -> LLVMTypeRef
    entry: Vec         # fni -> entry basic block
    cur_fni: int
    loc_name: Vec
    loc_slot: Vec
    loc_tag: Vec       # type-arena tag of each local (TY_INT / TY_BOOL)
    loop_cont: Vec
    loop_after: Vec
    err: int
    errmsg: string
    rv: int            # expression result value
    rk: int            # expression result kind (RK_*)
    rt: int            # result type-arena index (structs)
    temp_node: Vec     # aggregate-literal site -> entry temp (keyed by node)
    temp_ptr: Vec
    term: int          # current block is terminated

def gerr(g: Gen, msg: string) -> Gen:
    if g.err == 0:
        g.err = 1
        g.errmsg = msg
    return g

def gen_new(c: CState) -> Gen:
    g = Gen(
        c=c,
        ctx=LLVMContextCreate(),
        module=0,
        builder=0,
        i1=0,
        i8=0,
        i32=0,
        i64=0,
        f64=0,
        ty_void=0,
        ptr=0,
        printf=0,
        printf_ty=0,
        snprintf=0,
        snprintf_ty=0,
        rt_strlen=0,
        rt_strlen_ty=0,
        rt_strcmp=0,
        rt_strcmp_ty=0,
        rt_malloc=0,
        rt_malloc_ty=0,
        rt_memcpy=0,
        rt_memcpy_ty=0,
        fn_ref=vec_new(),
        fn_llty=vec_new(),
        entry=vec_new(),
        cur_fni=-1,
        loc_name=vec_new(),
        loc_slot=vec_new(),
        loc_tag=vec_new(),
        loop_cont=vec_new(),
        loop_after=vec_new(),
        err=0,
        errmsg="",
        rv=0,
        rk=0,
        rt=-1,
        temp_node=vec_new(),
        temp_ptr=vec_new(),
        term=0,
    )
    g.module = LLVMModuleCreateWithNameInContext("aoxn", g.ctx)
    g.i1 = LLVMInt1TypeInContext(g.ctx)
    g.i8 = LLVMInt8TypeInContext(g.ctx)
    g.i32 = LLVMInt32TypeInContext(g.ctx)
    g.i64 = LLVMInt64TypeInContext(g.ctx)
    g.f64 = LLVMDoubleTypeInContext(g.ctx)
    g.ty_void = LLVMVoidTypeInContext(g.ctx)
    g.ptr = LLVMPointerTypeInContext(g.ctx, 0)
    g.builder = LLVMCreateBuilderInContext(g.ctx)
    i = 0
    while i < c.fn_name.len:
        g.fn_ref = vec_push(g.fn_ref, 0)
        g.fn_llty = vec_push(g.fn_llty, 0)
        g.entry = vec_push(g.entry, 0)
        i = i + 1
    return g

# ---- helpers ----

def ty_ll(g: Gen, ty: int) -> int:
    t = ty_tag(g.c, ty)
    if t == TY_INT():
        return g.i64
    if t == TY_FLOAT():
        return g.f64
    if t == TY_BOOL():
        return g.i1
    if t == TY_STR():
        return g.ptr
    if t == TY_STRUCT():
        return LLVMGetTypeByName(g.module, ty_sname(g.c, ty))
    if t == TY_ARRAY():
        return LLVMArrayType(ty_ll(g, ty_elem(g.c, ty)), ty_len(g.c, ty))
    if t == TY_VOID():
        return 0
    return -1

# structs and arrays share one ABI: address-passed, value-semantics copied
def is_agg(tag: int) -> int:
    if tag == TY_STRUCT():
        return 1
    if tag == TY_ARRAY():
        return 1
    return 0

def local_slot(g: Gen, name: string) -> int:
    i = g.loc_name.len - 1
    while i >= 0:
        if as_string(vec_get(g.loc_name, i)) == name:
            return vec_get(g.loc_slot, i)
        i = i - 1
    return 0

def local_tag(g: Gen, name: string) -> int:
    i = g.loc_name.len - 1
    while i >= 0:
        if as_string(vec_get(g.loc_name, i)) == name:
            return vec_get(g.loc_tag, i)
        i = i - 1
    return -1

# field type-arena index of a struct field (declaration order)
def field_ty_idx(c: CState, sname: string, fname: string) -> int:
    j = 0
    while j < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, j)) == sname and as_string(vec_get(c.sf_name, j)) == fname:
            return vec_get(c.sf_ty, j)
        j = j + 1
    return -1

# 0-based field index (skips the empty reservation rows)
def field_index(c: CState, sname: string, fname: string) -> int:
    idx = 0
    j = 0
    while j < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, j)) == sname and as_string(vec_get(c.sf_name, j)) != "":
            if as_string(vec_get(c.sf_name, j)) == fname:
                return idx
            idx = idx + 1
        j = j + 1
    return -1

# type-arena index of a scalar value kind
def kind_ty(g: Gen, kind: int) -> int:
    if kind == RK_INT():
        return g.c.t_int
    if kind == RK_FLOAT():
        return g.c.t_float
    if kind == RK_BOOL():
        return g.c.t_bool
    if kind == RK_STR():
        return g.c.t_str
    return -1

# entry-hoisted temp for an aggregate expression site (reused in loops)
def temp_for(g: Gen, node: int, llty: int) -> Gen:
    i = 0
    while i < g.temp_node.len:
        if vec_get(g.temp_node, i) == node:
            g.rv = vec_get(g.temp_ptr, i)
            g.rk = RK_STRUCT()
            return g
        i = i + 1
    slot = alloca_entry(g, llty, "tmp.agg")
    g.temp_node = vec_push(g.temp_node, node)
    g.temp_ptr = vec_push(g.temp_ptr, slot)
    g.rv = slot
    g.rk = RK_STRUCT()
    return g

# value-semantics copy of an aggregate (dst/src are addresses)
def memcpy_agg(g: Gen, dst: int, src: int, ty: int) -> Gen:
    g = get_rt(g, 4)
    cp = malloc(24)
    store_i64(cp, dst)
    store_i64(cp + 8, src)
    store_i64(cp + 16, LLVMSizeOf(ty_ll(g, ty)))
    LLVMBuildCall2(g.builder, g.rt_memcpy_ty, g.rt_memcpy, cp, 3, "")
    return g

# address of arr[idx]: base is a pointer to the array value
def elem_ptr(g: Gen, base: int, aty: int, idx: int) -> int:
    ix = malloc(16)
    store_i64(ix, LLVMConstInt(g.i64, 0, 0))
    store_i64(ix + 8, idx)
    return LLVMBuildGEP2(g.builder, ty_ll(g, aty), base, ix, 2, "elem")

# byte address for load_u8/store_u8: base may be a string pointer or an int
def mem_u8_ptr(g: Gen, bk: int, bv: int, off: int) -> int:
    if bk == RK_STR():
        ix = malloc(8)
        store_i64(ix, off)
        return LLVMBuildGEP2(g.builder, g.i8, bv, ix, 1, "mem.u8p")
    total = LLVMBuildAdd(g.builder, bv, off, "mem.addr")
    return LLVMBuildIntToPtr(g.builder, total, g.ptr, "mem.u8p")

# value kind of a declared type tag: RK_INT / RK_BOOL, -1 when unsupported
def tag_kind(tag: int) -> int:
    if tag == TY_INT():
        return RK_INT()
    if tag == TY_FLOAT():
        return RK_FLOAT()
    if tag == TY_BOOL():
        return RK_BOOL()
    if tag == TY_STR():
        return RK_STR()
    return -1

def get_printf(g: Gen) -> Gen:
    if g.printf != 0:
        return g
    buf = malloc(8)
    store_i64(buf, g.ptr)
    g.printf_ty = LLVMFunctionType(g.i32, buf, 1, 1)
    g.printf = LLVMAddFunction(g.module, "printf", g.printf_ty)
    return g

def fmt_ptr(g: Gen, s: string) -> int:
    return LLVMBuildGlobalStringPtr(g.builder, s, ".fmt")

def get_snprintf(g: Gen) -> Gen:
    if g.snprintf != 0:
        return g
    params = malloc(24)
    store_i64(params, g.ptr)
    store_i64(params + 8, g.i64)
    store_i64(params + 16, g.ptr)
    g.snprintf_ty = LLVMFunctionType(g.i32, params, 3, 1)
    g.snprintf = LLVMAddFunction(g.module, "snprintf", g.snprintf_ty)
    return g

# C runtime declarations emitted into the module on demand (a checked program
# need not declare them itself). Existing declarations are reused.
def get_rt(g: Gen, which: int) -> Gen:
    if which == 1:
        if g.rt_strlen != 0:
            return g
        p = malloc(8)
        store_i64(p, g.ptr)
        g.rt_strlen_ty = LLVMFunctionType(g.i64, p, 1, 0)
        g.rt_strlen = LLVMGetNamedFunction(g.module, "strlen")
        if g.rt_strlen == 0:
            g.rt_strlen = LLVMAddFunction(g.module, "strlen", g.rt_strlen_ty)
        return g
    if which == 2:
        if g.rt_strcmp != 0:
            return g
        p = malloc(16)
        store_i64(p, g.ptr)
        store_i64(p + 8, g.ptr)
        g.rt_strcmp_ty = LLVMFunctionType(g.i32, p, 2, 0)
        g.rt_strcmp = LLVMGetNamedFunction(g.module, "strcmp")
        if g.rt_strcmp == 0:
            g.rt_strcmp = LLVMAddFunction(g.module, "strcmp", g.rt_strcmp_ty)
        return g
    if which == 3:
        if g.rt_malloc != 0:
            return g
        p = malloc(8)
        store_i64(p, g.i64)
        g.rt_malloc_ty = LLVMFunctionType(g.ptr, p, 1, 0)
        g.rt_malloc = LLVMGetNamedFunction(g.module, "malloc")
        if g.rt_malloc == 0:
            g.rt_malloc = LLVMAddFunction(g.module, "malloc", g.rt_malloc_ty)
        return g
    if g.rt_memcpy != 0:
        return g
    p = malloc(24)
    store_i64(p, g.ptr)
    store_i64(p + 8, g.ptr)
    store_i64(p + 16, g.i64)
    g.rt_memcpy_ty = LLVMFunctionType(g.i64, p, 3, 0)
    g.rt_memcpy = LLVMGetNamedFunction(g.module, "memcpy")
    if g.rt_memcpy == 0:
        g.rt_memcpy = LLVMAddFunction(g.module, "memcpy", g.rt_memcpy_ty)
    return g

def call_strlen(g: Gen, s: int) -> int:
    g = get_rt(g, 1)
    p = malloc(8)
    store_i64(p, s)
    return LLVMBuildCall2(g.builder, g.rt_strlen_ty, g.rt_strlen, p, 1, "str.len")

# malloc(len1+len2+1) + two copies + NUL (strings are never freed)
def emit_str_concat(g: Gen, l: int, r: int) -> Gen:
    ll = call_strlen(g, l)
    rl = call_strlen(g, r)
    sum = LLVMBuildAdd(g.builder, ll, rl, "str.sum")
    total = LLVMBuildAdd(g.builder, sum, LLVMConstInt(g.i64, 1, 0), "str.cap")
    g = get_rt(g, 3)
    ma = malloc(8)
    store_i64(ma, total)
    buf = LLVMBuildCall2(g.builder, g.rt_malloc_ty, g.rt_malloc, ma, 1, "str.buf")
    g = get_rt(g, 4)
    cp = malloc(24)
    store_i64(cp, buf)
    store_i64(cp + 8, l)
    store_i64(cp + 16, ll)
    LLVMBuildCall2(g.builder, g.rt_memcpy_ty, g.rt_memcpy, cp, 3, "")
    idx = malloc(8)
    store_i64(idx, ll)
    mid = LLVMBuildGEP2(g.builder, g.i8, buf, idx, 1, "str.mid")
    cp2 = malloc(24)
    store_i64(cp2, mid)
    store_i64(cp2 + 8, r)
    store_i64(cp2 + 16, rl)
    LLVMBuildCall2(g.builder, g.rt_memcpy_ty, g.rt_memcpy, cp2, 3, "")
    idx2 = malloc(8)
    store_i64(idx2, sum)
    endp = LLVMBuildGEP2(g.builder, g.i8, buf, idx2, 1, "str.end")
    LLVMBuildStore(g.builder, LLVMConstInt(g.i8, 0, 0), endp)
    g.rv = buf
    g.rk = RK_STR()
    return g

# lexicographic comparison via strcmp
def emit_str_cmp(g: Gen, op: int, l: int, r: int) -> Gen:
    g = get_rt(g, 2)
    ca = malloc(16)
    store_i64(ca, l)
    store_i64(ca + 8, r)
    res = LLVMBuildCall2(g.builder, g.rt_strcmp_ty, g.rt_strcmp, ca, 2, "str.cmp")
    g.rv = LLVMBuildICmp(g.builder, cmp_pred(op), res, LLVMConstInt(g.i32, 0, 0), "cmp")
    g.rk = RK_BOOL()
    return g

def add_bb(g: Gen, fname: string) -> int:
    return LLVMAppendBasicBlockInContext(g.ctx, vec_get(g.fn_ref, g.cur_fni), fname)

def pos(g: Gen, bb: int) -> Gen:
    LLVMPositionBuilderAtEnd(g.builder, bb)
    g.term = 0
    g.rv = 0
    return g

# allocate in the entry block (allocas must not sit inside loops)
def alloca_entry(g: Gen, ty: int, name: string) -> int:
    cur = LLVMGetInsertBlock(g.builder)
    entry = vec_get(g.entry, g.cur_fni)
    first = LLVMGetFirstInstruction(entry)
    if first != 0:
        LLVMPositionBuilderBefore(g.builder, first)
    slot = LLVMBuildAlloca(g.builder, ty, name)
    LLVMPositionBuilderAtEnd(g.builder, cur)
    return slot

def emit_arith(g: Gen, op: int, l: int, r: int) -> int:
    if op == OP_ADD():
        return LLVMBuildAdd(g.builder, l, r, "add")
    if op == OP_SUB():
        return LLVMBuildSub(g.builder, l, r, "sub")
    if op == OP_MUL():
        return LLVMBuildMul(g.builder, l, r, "mul")
    if op == OP_DIV():
        return LLVMBuildSDiv(g.builder, l, r, "div")
    if op == OP_MOD():
        return LLVMBuildSRem(g.builder, l, r, "mod")
    return 0

def cmp_pred(op: int) -> int:
    if op == OP_EQ():
        return ICMP_EQ()
    if op == OP_NE():
        return ICMP_NE()
    if op == OP_LT():
        return ICMP_SLT()
    if op == OP_LE():
        return ICMP_SLE()
    if op == OP_GT():
        return ICMP_SGT()
    return ICMP_SGE()

# ---- declarations ----

def declare_fn(g: Gen, fni: int, node: int) -> Gen:
    name = as_string(vec_get(g.c.fn_name, fni))
    is_extern = node_ival(g.c.p, node)
    ret_ty = vec_get(g.c.fn_ret, fni)
    rtag = ty_tag(g.c, ret_ty)
    rll = ty_ll(g, ret_ty)
    if rll == -1:
        return gerr(g, "codegen: function '" + name + "' has an unsupported return type")
    # compound returns use an sret out-pointer: (ptr %ret, params...) -> void
    sret = 0
    if is_agg(rtag) == 1:
        sret = 1
        rll = g.ty_void
    elif rtag == TY_VOID():
        rll = g.ty_void
    np = vec_get(g.c.fn_nparam, fni)
    total = np + sret
    buf = 0
    if total > 0:
        buf = malloc(total * 8)
    if sret == 1:
        store_i64(buf, g.ptr)
    k = 0
    while k < np:
        pty = sig_param_ty(g.c, fni, k)
        ptag = ty_tag(g.c, pty)
        pll = 0
        if is_agg(ptag) == 1:
            pll = g.ptr
        else:
            pll = ty_ll(g, pty)
        if pll == -1:
            return gerr(g, "codegen: function '" + name + "' has an unsupported parameter type")
        store_i64(buf + (k + sret) * 8, pll)
        k = k + 1
    fnty = LLVMFunctionType(rll, buf, total, 0)
    sym = name
    if name == "main":
        sym = "aoxn.main"
    ref = LLVMAddFunction(g.module, sym, fnty)
    entry = 0
    if is_extern == 0:
        entry = LLVMAppendBasicBlockInContext(g.ctx, ref, "entry")
    vec_set(g.fn_ref, fni, ref)
    vec_set(g.fn_llty, fni, fnty)
    vec_set(g.entry, fni, entry)
    return g

# ---- expressions ----

def emit_expr(g: Gen, e: int) -> Gen:
    if g.err == 1:
        return g
    t = node_tag(g.c.p, e)
    if t == N_INT():
        g.rv = LLVMConstInt(g.i64, node_ival(g.c.p, e), 1)
        g.rk = RK_INT()
        return g
    if t == N_FLOAT():
        g.rv = LLVMConstReal(g.f64, strtod(node_sval(g.c.p, e), 0))
        g.rk = RK_FLOAT()
        return g
    if t == N_BOOL():
        g.rv = LLVMConstInt(g.i1, node_ival(g.c.p, e), 0)
        g.rk = RK_BOOL()
        return g
    if t == N_STR():
        g.rv = LLVMBuildGlobalStringPtr(g.builder, node_sval(g.c.p, e), ".str")
        g.rk = RK_STR()
        return g
    if t == N_VAR():
        name = node_sval(g.c.p, e)
        slot = local_slot(g, name)
        if slot == 0:
            return gerr(g, "codegen: unknown local '" + name + "'")
        lty = local_tag(g, name)
        tag = ty_tag(g.c, lty)
        if tag == TY_BOOL():
            g.rv = LLVMBuildLoad2(g.builder, g.i1, slot, name)
            g.rk = RK_BOOL()
        elif tag == TY_STR():
            g.rv = LLVMBuildLoad2(g.builder, g.ptr, slot, name)
            g.rk = RK_STR()
        elif tag == TY_FLOAT():
            g.rv = LLVMBuildLoad2(g.builder, g.f64, slot, name)
            g.rk = RK_FLOAT()
        elif is_agg(tag) == 1:
            g.rv = slot
            g.rk = RK_STRUCT()
            g.rt = lty
        else:
            g.rv = LLVMBuildLoad2(g.builder, g.i64, slot, name)
            g.rk = RK_INT()
        return g
    if t == N_UNARY():
        op = node_ival(g.c.p, e)
        g = emit_expr(g, node_child(g.c.p, e))
        if g.err == 1:
            return g
        if op == OP_NEG():
            if g.rk == RK_FLOAT():
                g.rv = LLVMBuildFNeg(g.builder, g.rv, "neg")
                g.rk = RK_FLOAT()
                return g
            if g.rk != RK_INT():
                return gerr(g, "codegen: unary '-' expects int or float")
            zero = LLVMConstInt(g.i64, 0, 1)
            g.rv = LLVMBuildSub(g.builder, zero, g.rv, "neg")
            g.rk = RK_INT()
            return g
        if op == OP_NOT():
            if g.rk != RK_BOOL():
                return gerr(g, "codegen: '!' expects bool")
            g.rv = LLVMBuildNot(g.builder, g.rv, "not")
            g.rk = RK_BOOL()
            return g
        return gerr(g, "codegen: unsupported unary operator")
    if t == N_BINARY():
        return emit_binary(g, e)
    if t == N_FIELDACCESS():
        return emit_field_access(g, e)
    if t == N_ARRAYLIT():
        return emit_array_lit(g, e)
    if t == N_INDEX():
        return emit_index_access(g, e)
    if t == N_CALL():
        return emit_call(g, e)
    return gerr(g, "codegen: unsupported expression (tag " + str(t) + ")")

def emit_binary(g: Gen, e: int) -> Gen:
    op = node_ival(g.c.p, e)
    lhs = node_child(g.c.p, e)
    rhs = node_next(g.c.p, lhs)
    if op == OP_AND() or op == OP_OR():
        return emit_short_circuit(g, e)
    g = emit_expr(g, lhs)
    if g.err == 1:
        return g
    lv = g.rv
    lk = g.rk
    g = emit_expr(g, rhs)
    if g.err == 1:
        return g
    rv = g.rv
    rk = g.rk
    if op == OP_EQ() or op == OP_NE() or op == OP_LT() or op == OP_LE() or op == OP_GT() or op == OP_GE():
        if lk != rk:
            return gerr(g, "codegen: comparison operands must share a kind")
        if lk == RK_STR():
            return emit_str_cmp(g, op, lv, rv)
        if lk == RK_INT():
            g.rv = LLVMBuildICmp(g.builder, cmp_pred(op), lv, rv, "cmp")
        elif lk == RK_FLOAT():
            g.rv = LLVMBuildFCmp(g.builder, fcmp_pred(op), lv, rv, "cmp")
        else:
            # bool equality as int comparison of the i1 values
            pred = ICMP_EQ()
            if op == OP_NE():
                pred = ICMP_NE()
            elif op != OP_EQ():
                return gerr(g, "codegen: bool ordering is not supported")
            g.rv = LLVMBuildICmp(g.builder, pred, lv, rv, "cmp")
        g.rk = RK_BOOL()
        return g
    if op == OP_ADD() and lk == RK_STR() and rk == RK_STR():
        return emit_str_concat(g, lv, rv)
    if lk == RK_FLOAT() and rk == RK_FLOAT():
        return emit_farith(g, op, lv, rv)
    if lk != RK_INT() or rk != RK_INT():
        return gerr(g, "codegen: arithmetic requires int or float operands")
    g.rv = emit_arith(g, op, lv, rv)
    if g.rv == 0:
        return gerr(g, "codegen: unsupported binary operator")
    g.rk = RK_INT()
    return g

def fcmp_pred(op: int) -> int:
    if op == OP_EQ():
        return REAL_OEQ()
    if op == OP_NE():
        return REAL_UNE()
    if op == OP_LT():
        return REAL_OLT()
    if op == OP_LE():
        return REAL_OLE()
    if op == OP_GT():
        return REAL_OGT()
    return REAL_OGE()

def emit_farith(g: Gen, op: int, l: int, r: int) -> Gen:
    if op == OP_ADD():
        g.rv = LLVMBuildFAdd(g.builder, l, r, "fadd")
    elif op == OP_SUB():
        g.rv = LLVMBuildFSub(g.builder, l, r, "fsub")
    elif op == OP_MUL():
        g.rv = LLVMBuildFMul(g.builder, l, r, "fmul")
    elif op == OP_DIV():
        g.rv = LLVMBuildFDiv(g.builder, l, r, "fdiv")
    else:
        return gerr(g, "codegen: '%' is not defined for floats")
    g.rk = RK_FLOAT()
    return g

# short-circuit 'and'/'or': branch around the rhs, merge with a phi
def emit_short_circuit(g: Gen, e: int) -> Gen:
    op = node_ival(g.c.p, e)
    lhs = node_child(g.c.p, e)
    rhs = node_next(g.c.p, lhs)
    g = emit_expr(g, lhs)
    if g.err == 1:
        return g
    if g.rk != RK_BOOL():
        return gerr(g, "codegen: 'and'/'or' require bool operands")
    lv = g.rv
    lhs_bb = LLVMGetInsertBlock(g.builder)
    rhs_bb = add_bb(g, "sc.rhs")
    end_bb = add_bb(g, "sc.end")
    if op == OP_AND():
        LLVMBuildCondBr(g.builder, lv, rhs_bb, end_bb)
    else:
        LLVMBuildCondBr(g.builder, lv, end_bb, rhs_bb)
    g = pos(g, rhs_bb)
    g = emit_expr(g, rhs)
    if g.err == 1:
        return g
    if g.rk != RK_BOOL():
        return gerr(g, "codegen: 'and'/'or' require bool operands")
    rv = g.rv
    rhs_end = LLVMGetInsertBlock(g.builder)
    LLVMBuildBr(g.builder, end_bb)
    g = pos(g, end_bb)
    phi = LLVMBuildPhi(g.builder, g.i1, "sc.val")
    skip = LLVMConstInt(g.i1, 0, 0)
    if op == OP_OR():
        skip = LLVMConstInt(g.i1, 1, 0)
    vals = malloc(16)
    store_i64(vals, rv)
    store_i64(vals + 8, skip)
    bbs = malloc(16)
    store_i64(bbs, rhs_end)
    store_i64(bbs + 8, lhs_bb)
    LLVMAddIncoming(phi, vals, bbs, 2)
    g.rv = phi
    g.rk = RK_BOOL()
    return g

# array literal (or [elem] * N replication): fill an entry-hoisted temp
def emit_array_lit(g: Gen, e: int) -> Gen:
    rep = node_ival(g.c.p, e)
    if rep != 0:
        # replication form: evaluate the element once, fill with a runtime loop
        g = emit_expr(g, node_child(g.c.p, e))
        if g.err == 1:
            return g
        ev = g.rv
        ek = g.rk
        ety = -1
        if ek == RK_STRUCT():
            ety = g.rt
        else:
            ety = kind_ty(g, ek)
        c2 = alloc_ty(g.c, TY_ARRAY(), ety, rep, "")
        g.c = c2
        aty = c2.r_ty
        g = temp_for(g, e, ty_ll(g, aty))
        base = g.rv
        g.rt = aty
        i_slot = alloca_entry(g, g.i64, "rep.i")
        LLVMBuildStore(g.builder, LLVMConstInt(g.i64, 0, 0), i_slot)
        head = add_bb(g, "rep.head")
        body = add_bb(g, "rep.body")
        after = add_bb(g, "rep.after")
        LLVMBuildBr(g.builder, head)
        g = pos(g, head)
        iv = LLVMBuildLoad2(g.builder, g.i64, i_slot, "rep.i")
        cond = LLVMBuildICmp(g.builder, ICMP_SLT(), iv, LLVMConstInt(g.i64, rep, 0), "rep.c")
        LLVMBuildCondBr(g.builder, cond, body, after)
        g = pos(g, body)
        eptr = elem_ptr(g, base, aty, iv)
        if ek == RK_STRUCT():
            g = memcpy_agg(g, eptr, ev, ety)
        else:
            LLVMBuildStore(g.builder, ev, eptr)
        nxt = LLVMBuildAdd(g.builder, iv, LLVMConstInt(g.i64, 1, 0), "rep.next")
        LLVMBuildStore(g.builder, nxt, i_slot)
        LLVMBuildBr(g.builder, head)
        g = pos(g, after)
        g.rv = base
        g.rk = RK_STRUCT()
        g.rt = aty
        return g
    first = node_child(g.c.p, e)
    if first == -1:
        return gerr(g, "codegen: empty array literal")
    g = emit_expr(g, first)
    if g.err == 1:
        return g
    ek = g.rk
    ev0 = g.rv
    ety = -1
    if ek == RK_STRUCT():
        ety = g.rt
    else:
        ety = kind_ty(g, ek)
    if ety == -1:
        return gerr(g, "codegen: unsupported array element kind")
    n = 1
    ch = node_next(g.c.p, first)
    while ch != -1:
        n = n + 1
        ch = node_next(g.c.p, ch)
    c2 = alloc_ty(g.c, TY_ARRAY(), ety, n, "")
    g.c = c2
    aty = c2.r_ty
    g = temp_for(g, e, ty_ll(g, aty))
    base = g.rv
    i = 0
    ch = first
    while ch != -1 and g.err == 0:
        ev = ev0
        if i > 0:
            g = emit_expr(g, ch)
            if g.err == 1:
                return g
            ev = g.rv
        eptr = elem_ptr(g, base, aty, LLVMConstInt(g.i64, i, 0))
        if ek == RK_STRUCT():
            g = memcpy_agg(g, eptr, ev, ety)
        else:
            LLVMBuildStore(g.builder, ev, eptr)
        i = i + 1
        ch = node_next(g.c.p, ch)
    g.rv = base
    g.rk = RK_STRUCT()
    g.rt = aty
    return g

# address of arr[i] (e is an N_INDEX node); rv = element address, rt = elem type
def emit_index_ptr(g: Gen, e: int) -> Gen:
    base_e = node_child(g.c.p, e)
    idx_e = node_next(g.c.p, base_e)
    g = emit_expr(g, base_e)
    if g.err == 1:
        return g
    if g.rk != RK_STRUCT() or ty_tag(g.c, g.rt) != TY_ARRAY():
        return gerr(g, "codegen: indexing a non-array value")
    aty = g.rt
    base = g.rv
    g = emit_expr(g, idx_e)
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: array index must be int")
    ety = ty_elem(g.c, aty)
    g.rv = elem_ptr(g, base, aty, g.rv)
    g.rt = ety
    g.rk = RK_STRUCT()
    return g

# rvalue indexing: the element address for compounds, a load for scalars
def emit_index_access(g: Gen, e: int) -> Gen:
    g = emit_index_ptr(g, e)
    if g.err == 1:
        return g
    ety = g.rt
    tag = ty_tag(g.c, ety)
    if is_agg(tag) == 1:
        return g
    g.rv = LLVMBuildLoad2(g.builder, ty_ll(g, ety), g.rv, "elem")
    g.rk = tag_kind(tag)
    return g

def emit_call(g: Gen, e: int) -> Gen:
    name = node_sval(g.c.p, e)
    if name == "print":
        return emit_print(g, e)
    if name == "len":
        return emit_len(g, e)
    if name == "str":
        return emit_str(g, e)
    if name == "load_i64" or name == "load_f64":
        return emit_mem_load(g, e)
    if name == "load_u8":
        return emit_mem_load_u8(g, e)
    if name == "store_i64" or name == "store_f64":
        return emit_mem_store(g, e)
    if name == "store_u8":
        return emit_mem_store_u8(g, e)
    if name == "target_os":
        # the host platform of this compiler (same value the Rust compiler folds)
        g.rv = LLVMBuildGlobalStringPtr(g.builder, target_os(), ".target_os")
        g.rk = RK_STR()
        return g
    if name == "as_string":
        return emit_as_string(g, e)
    if name == "as_ptr":
        return emit_as_ptr(g, e)
    # generic calls already have their instance routed by the checker
    fni = -1
    i = 0
    while i < g.c.call_node.len:
        if vec_get(g.c.call_node, i) == e:
            fni = vec_get(g.c.call_fni, i)
        i = i + 1
    if fni == -1:
        fni = sig_index(g.c, name)
    if fni == -1:
        if struct_known(g.c, name) == 1:
            return emit_struct_lit(g, e, name)
        return gerr(g, "codegen: call to undefined function '" + name + "'")
    rty = vec_get(g.c.fn_ret, fni)
    sret = 0
    if is_agg(ty_tag(g.c, rty)) == 1:
        sret = 1
    np = vec_get(g.c.fn_nparam, fni)
    total = np + sret
    buf = 0
    if total > 0:
        buf = malloc(total * 8)
    out_tmp = 0
    if sret == 1:
        g = temp_for(g, e, ty_ll(g, rty))
        out_tmp = g.rv
        store_i64(buf, out_tmp)
    k = 0
    a = node_child(g.c.p, e)
    while a != -1 and g.err == 0:
        pty = sig_param_ty(g.c, fni, k)
        ptag = ty_tag(g.c, pty)
        g = emit_expr(g, node_child(g.c.p, a))
        if g.err == 1:
            return g
        if is_agg(ptag) == 1:
            if g.rk != RK_STRUCT():
                return gerr(g, "codegen: aggregate argument expected in call to '" + name + "'")
            # pass the address; the callee copies (value semantics)
            store_i64(buf + (k + sret) * 8, g.rv)
        else:
            want = tag_kind(ptag)
            if want == -1:
                return gerr(g, "codegen: unsupported parameter type in call to '" + name + "'")
            if g.rk != want:
                return gerr(g, "codegen: argument kind mismatch in call to '" + name + "'")
            store_i64(buf + (k + sret) * 8, g.rv)
        k = k + 1
        a = node_next(g.c.p, a)
    if k != np:
        return gerr(g, "codegen: wrong number of arguments for '" + name + "'")
    ref = vec_get(g.fn_ref, fni)
    fnty = vec_get(g.fn_llty, fni)
    r = LLVMBuildCall2(g.builder, fnty, ref, buf, total, "")
    if sret == 1:
        g.rv = out_tmp
        g.rk = RK_STRUCT()
        g.rt = rty
        return g
    tag = ty_tag(g.c, rty)
    if tag == TY_VOID():
        g.rk = RK_VOID()
    elif tag == TY_BOOL():
        g.rk = RK_BOOL()
    elif tag == TY_STR():
        g.rk = RK_STR()
    elif tag == TY_FLOAT():
        g.rk = RK_FLOAT()
    else:
        g.rk = RK_INT()
    g.rv = r
    return g

# struct construction: fill an entry temp field by field (value semantics)
def emit_struct_lit(g: Gen, e: int, name: string) -> Gen:
    c2 = alloc_ty(g.c, TY_STRUCT(), 0, 0, name)
    g.c = c2
    ty = c2.r_ty
    llty = ty_ll(g, ty)
    if llty == 0:
        return gerr(g, "codegen: struct '" + name + "' was not declared")
    g = temp_for(g, e, llty)
    base = g.rv
    a = node_child(g.c.p, e)
    while a != -1 and g.err == 0:
        fname = node_sval(g.c.p, a)
        fidx = field_index(g.c, name, fname)
        fty = field_ty_idx(g.c, name, fname)
        if fidx == -1 or fty == -1:
            return gerr(g, "codegen: unknown field '" + fname + "' of '" + name + "'")
        idx = malloc(8)
        store_i64(idx, LLVMConstInt(g.i32, 0, 0))
        store_i64(idx + 8, LLVMConstInt(g.i32, fidx, 0))
        fptr = LLVMBuildGEP2(g.builder, llty, base, idx, 2, "ctor.field")
        g = emit_expr(g, node_child(g.c.p, a))
        if g.err == 1:
            return g
        if is_agg(ty_tag(g.c, fty)) == 1:
            if g.rk != RK_STRUCT():
                return gerr(g, "codegen: compound field requires a compound value")
            g = memcpy_agg(g, fptr, g.rv, fty)
        else:
            want = tag_kind(ty_tag(g.c, fty))
            if want == -1 or g.rk != want:
                return gerr(g, "codegen: field kind mismatch in '" + name + "'")
            LLVMBuildStore(g.builder, g.rv, fptr)
        a = node_next(g.c.p, a)
    g.rv = base
    g.rk = RK_STRUCT()
    g.rt = ty
    return g

# print(int) / print(bool): printf("%lld\n") or a true/false branch
def emit_print(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: print expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    g = get_printf(g)
    if g.rk == RK_INT():
        fmt = fmt_ptr(g, "%lld\n")
        args = malloc(16)
        store_i64(args, fmt)
        store_i64(args + 8, g.rv)
        LLVMBuildCall2(g.builder, g.printf_ty, g.printf, args, 2, "")
        g.rk = RK_VOID()
        g.rv = 0
        return g
    if g.rk == RK_FLOAT():
        fmt = fmt_ptr(g, "%f\n")
        args = malloc(16)
        store_i64(args, fmt)
        store_i64(args + 8, g.rv)
        LLVMBuildCall2(g.builder, g.printf_ty, g.printf, args, 2, "")
        g.rk = RK_VOID()
        g.rv = 0
        return g
    if g.rk == RK_BOOL():
        v = g.rv
        tbb = add_bb(g, "print.true")
        fbb = add_bb(g, "print.false")
        end = add_bb(g, "print.end")
        LLVMBuildCondBr(g.builder, v, tbb, fbb)
        fmt = fmt_ptr(g, "%s\n")
        tstr = LLVMBuildGlobalStringPtr(g.builder, "true", ".true")
        fstr = LLVMBuildGlobalStringPtr(g.builder, "false", ".false")
        g = pos(g, tbb)
        ta = malloc(16)
        store_i64(ta, fmt)
        store_i64(ta + 8, tstr)
        LLVMBuildCall2(g.builder, g.printf_ty, g.printf, ta, 2, "")
        LLVMBuildBr(g.builder, end)
        g = pos(g, fbb)
        fa = malloc(16)
        store_i64(fa, fmt)
        store_i64(fa + 8, fstr)
        LLVMBuildCall2(g.builder, g.printf_ty, g.printf, fa, 2, "")
        LLVMBuildBr(g.builder, end)
        g = pos(g, end)
        g.rk = RK_VOID()
        g.rv = 0
        return g
    if g.rk == RK_STR():
        fmt = fmt_ptr(g, "%s\n")
        args = malloc(16)
        store_i64(args, fmt)
        store_i64(args + 8, g.rv)
        LLVMBuildCall2(g.builder, g.printf_ty, g.printf, args, 2, "")
        g.rk = RK_VOID()
        g.rv = 0
        return g
    return gerr(g, "codegen: print supports int/float/bool/string yet")

# len(string) -> strlen; len(array) -> its static length
def emit_len(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: len expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk == RK_STR():
        g.rv = call_strlen(g, g.rv)
        g.rk = RK_INT()
        return g
    if g.rk == RK_STRUCT() and ty_tag(g.c, g.rt) == TY_ARRAY():
        g.rv = LLVMConstInt(g.i64, ty_len(g.c, g.rt), 1)
        g.rk = RK_INT()
        return g
    return gerr(g, "codegen: len supports strings and arrays")

# str(string) identity; str(int) via snprintf("%lld"); str(bool) via phi
def emit_str(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: str expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk == RK_STR():
        return g
    if g.rk == RK_INT() or g.rk == RK_FLOAT():
        cap = 32
        fmt = "%lld"
        if g.rk == RK_FLOAT():
            cap = 64
            fmt = "%f"
        g = get_snprintf(g)
        g = get_rt(g, 3)
        ma = malloc(8)
        store_i64(ma, LLVMConstInt(g.i64, cap, 0))
        buf = LLVMBuildCall2(g.builder, g.rt_malloc_ty, g.rt_malloc, ma, 1, "str.buf")
        sargs = malloc(32)
        store_i64(sargs, buf)
        store_i64(sargs + 8, LLVMConstInt(g.i64, cap, 0))
        store_i64(sargs + 16, fmt_ptr(g, fmt))
        store_i64(sargs + 24, g.rv)
        LLVMBuildCall2(g.builder, g.snprintf_ty, g.snprintf, sargs, 4, "")
        g.rv = buf
        g.rk = RK_STR()
        return g
    if g.rk == RK_BOOL():
        v = g.rv
        tbb = add_bb(g, "str.true")
        fbb = add_bb(g, "str.false")
        end = add_bb(g, "str.end")
        tstr = LLVMBuildGlobalStringPtr(g.builder, "true", ".true")
        fstr = LLVMBuildGlobalStringPtr(g.builder, "false", ".false")
        LLVMBuildCondBr(g.builder, v, tbb, fbb)
        g = pos(g, tbb)
        LLVMBuildBr(g.builder, end)
        g = pos(g, fbb)
        LLVMBuildBr(g.builder, end)
        g = pos(g, end)
        phi = LLVMBuildPhi(g.builder, g.ptr, "str.bool")
        vals = malloc(16)
        store_i64(vals, tstr)
        store_i64(vals + 8, fstr)
        bbs = malloc(16)
        store_i64(bbs, tbb)
        store_i64(bbs + 8, fbb)
        LLVMAddIncoming(phi, vals, bbs, 2)
        g.rv = phi
        g.rk = RK_STR()
        return g
    return gerr(g, "codegen: str supports int/bool/string yet")

# ---- raw memory builtins (unsafe, stdlib escape hatch) ----

def emit_mem_load(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: load expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: load address must be int")
    ptr = LLVMBuildIntToPtr(g.builder, g.rv, g.ptr, "mem.addr")
    if node_sval(g.c.p, e) == "load_f64":
        g.rv = LLVMBuildLoad2(g.builder, g.f64, ptr, "mem.f64")
        g.rk = RK_FLOAT()
    else:
        g.rv = LLVMBuildLoad2(g.builder, g.i64, ptr, "mem.i64")
        g.rk = RK_INT()
    return g

def emit_mem_load_u8(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    a2 = node_next(g.c.p, a)
    if a == -1 or a2 == -1 or node_next(g.c.p, a2) != -1:
        return gerr(g, "codegen: load_u8 expects (base, offset)")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    bk = g.rk
    bv = g.rv
    g = emit_expr(g, node_child(g.c.p, a2))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: load_u8 offset must be int")
    if bk != RK_STR() and bk != RK_INT():
        return gerr(g, "codegen: load_u8 base must be int or string")
    ptr = mem_u8_ptr(g, bk, bv, g.rv)
    v = LLVMBuildLoad2(g.builder, g.i8, ptr, "mem.u8")
    g.rv = LLVMBuildZExt(g.builder, v, g.i64, "mem.u8z")
    g.rk = RK_INT()
    return g

def emit_mem_store(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    a2 = node_next(g.c.p, a)
    if a == -1 or a2 == -1 or node_next(g.c.p, a2) != -1:
        return gerr(g, "codegen: store expects (address, value)")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: store address must be int")
    addr = g.rv
    g = emit_expr(g, node_child(g.c.p, a2))
    if g.err == 1:
        return g
    ptr = LLVMBuildIntToPtr(g.builder, addr, g.ptr, "mem.addr")
    if node_sval(g.c.p, e) == "store_f64":
        if g.rk != RK_FLOAT():
            return gerr(g, "codegen: store_f64 value must be float")
    elif g.rk != RK_INT():
        return gerr(g, "codegen: store_i64 value must be int")
    LLVMBuildStore(g.builder, g.rv, ptr)
    g.rv = 0
    g.rk = RK_VOID()
    return g

def emit_mem_store_u8(g: Gen, e: int) -> Gen:
    a1 = node_child(g.c.p, e)
    a2 = node_next(g.c.p, a1)
    a3 = node_next(g.c.p, a2)
    if a1 == -1 or a2 == -1 or a3 == -1 or node_next(g.c.p, a3) != -1:
        return gerr(g, "codegen: store_u8 expects (base, offset, value)")
    g = emit_expr(g, node_child(g.c.p, a1))
    if g.err == 1:
        return g
    bk = g.rk
    bv = g.rv
    g = emit_expr(g, node_child(g.c.p, a2))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: store_u8 offset must be int")
    if bk != RK_STR() and bk != RK_INT():
        return gerr(g, "codegen: store_u8 base must be int or string")
    off = g.rv
    g = emit_expr(g, node_child(g.c.p, a3))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: store_u8 value must be int")
    ptr = mem_u8_ptr(g, bk, bv, off)
    v = LLVMBuildTrunc(g.builder, g.rv, g.i8, "mem.u8t")
    LLVMBuildStore(g.builder, v, ptr)
    g.rv = 0
    g.rk = RK_VOID()
    return g

def emit_as_string(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: as_string expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk != RK_INT():
        return gerr(g, "codegen: as_string expects int")
    g.rv = LLVMBuildIntToPtr(g.builder, g.rv, g.ptr, "mem.str")
    g.rk = RK_STR()
    return g

def emit_as_ptr(g: Gen, e: int) -> Gen:
    a = node_child(g.c.p, e)
    if a == -1 or node_next(g.c.p, a) != -1:
        return gerr(g, "codegen: as_ptr expects exactly 1 argument")
    g = emit_expr(g, node_child(g.c.p, a))
    if g.err == 1:
        return g
    if g.rk != RK_STR():
        return gerr(g, "codegen: as_ptr expects string")
    g.rv = LLVMBuildPtrToInt(g.builder, g.rv, g.i64, "mem.ptr")
    g.rk = RK_INT()
    return g

# ---- statements ----

def emit_stmt(g: Gen, stmt: int) -> Gen:
    if g.err == 1:
        return g
    if g.term == 1:
        return g
    t = node_tag(g.c.p, stmt)
    if t == N_BLOCK():
        return emit_block(g, stmt)
    if t == N_LET():
        return emit_let(g, stmt)
    if t == N_ASSIGN():
        return emit_assign(g, stmt)
    if t == N_EXPRSTMT():
        g = emit_expr(g, node_child(g.c.p, stmt))
        return g
    if t == N_RETURN():
        return emit_return(g, stmt)
    if t == N_IF():
        return emit_if(g, stmt)
    if t == N_WHILE():
        return emit_while(g, stmt)
    if t == N_FOR():
        return emit_for(g, stmt)
    if t == N_BREAK():
        if g.loop_after.len == 0:
            return gerr(g, "codegen: break outside of a loop")
        LLVMBuildBr(g.builder, vec_get(g.loop_after, g.loop_after.len - 1))
        g.term = 1
        return g
    if t == N_CONTINUE():
        if g.loop_cont.len == 0:
            return gerr(g, "codegen: continue outside of a loop")
        LLVMBuildBr(g.builder, vec_get(g.loop_cont, g.loop_cont.len - 1))
        g.term = 1
        return g
    if t == N_PASS():
        return g
    return gerr(g, "codegen: unsupported statement (tag " + str(t) + ")")

def emit_block(g: Gen, block: int) -> Gen:
    st = node_child(g.c.p, block)
    while st != -1 and g.err == 0 and g.term == 0:
        g = emit_stmt(g, st)
        st = node_next(g.c.p, st)
    return g

def emit_let(g: Gen, stmt: int) -> Gen:
    name = node_sval(g.c.p, stmt)
    value = node_child(g.c.p, stmt)
    ann = -1
    if node_ival(g.c.p, stmt) == 1:
        tyn = value
        value = node_next(g.c.p, tyn)
        c2 = resolve_ty_node(g.c, tyn)
        if c2.err == 1:
            g.c = c2
            g.err = 1
            g.errmsg = c2.errmsg
            return g
        ann = c2.r_ty
    g = emit_expr(g, value)
    if g.err == 1:
        return g
    if g.rk == RK_STRUCT():
        ty = g.rt
        if ann != -1 and ty_eq(g.c, ann, ty) == 0:
            return gerr(g, "codegen: annotation does not match the initializer")
        slot = local_slot(g, name)
        if slot == 0:
            slot = alloca_entry(g, ty_ll(g, ty), name)
            g.loc_name = vec_push(g.loc_name, as_ptr(name))
            g.loc_slot = vec_push(g.loc_slot, slot)
            g.loc_tag = vec_push(g.loc_tag, ty)
        elif ty_eq(g.c, local_tag(g, name), ty) == 0:
            return gerr(g, "codegen: cannot rebind '" + name + "' with a different type")
        return memcpy_agg(g, slot, g.rv, ty)
    if g.rk != RK_INT() and g.rk != RK_BOOL() and g.rk != RK_STR() and g.rk != RK_FLOAT():
        return gerr(g, "codegen: unsupported binding kind")
    if ann != -1 and tag_kind(ty_tag(g.c, ann)) != g.rk:
        return gerr(g, "codegen: annotation does not match the initializer")
    ty = kind_ty(g, g.rk)
    slot = local_slot(g, name)
    if slot == 0:
        slot = alloca_entry(g, ty_ll(g, ty), name)
        g.loc_name = vec_push(g.loc_name, as_ptr(name))
        g.loc_slot = vec_push(g.loc_slot, slot)
        g.loc_tag = vec_push(g.loc_tag, ty)
    elif ty_tag(g.c, local_tag(g, name)) != ty_tag(g.c, ty):
        return gerr(g, "codegen: cannot rebind '" + name + "' with a different type")
    LLVMBuildStore(g.builder, g.rv, slot)
    return g

# address of a struct field (e is N_FIELDACCESS); rt = field type index
def emit_field_ptr(g: Gen, e: int) -> Gen:
    obj = node_child(g.c.p, e)
    g = emit_expr(g, obj)
    if g.err == 1:
        return g
    if g.rk != RK_STRUCT():
        return gerr(g, "codegen: field access on a non-struct value")
    bty = g.rt
    sname = ty_sname(g.c, bty)
    fname = node_sval(g.c.p, e)
    fidx = field_index(g.c, sname, fname)
    fty = field_ty_idx(g.c, sname, fname)
    if fidx == -1 or fty == -1:
        return gerr(g, "codegen: unknown field '" + fname + "' of '" + sname + "'")
    idx = malloc(8)
    store_i64(idx, LLVMConstInt(g.i32, 0, 0))
    store_i64(idx + 8, LLVMConstInt(g.i32, fidx, 0))
    fptr = LLVMBuildGEP2(g.builder, ty_ll(g, bty), g.rv, idx, 2, "field")
    g.rv = fptr
    g.rt = fty
    g.rk = RK_STRUCT()
    return g

# rvalue field access: address for compound fields, loaded scalar otherwise
def emit_field_access(g: Gen, e: int) -> Gen:
    g = emit_field_ptr(g, e)
    if g.err == 1:
        return g
    fty = g.rt
    tag = ty_tag(g.c, fty)
    if is_agg(tag) == 1:
        return g
    g.rv = LLVMBuildLoad2(g.builder, ty_ll(g, fty), g.rv, node_sval(g.c.p, e))
    g.rk = tag_kind(tag)
    return g

def emit_assign(g: Gen, stmt: int) -> Gen:
    target = node_child(g.c.p, stmt)
    value = node_next(g.c.p, target)
    t = node_tag(g.c.p, target)
    if t == N_VAR():
        name = node_sval(g.c.p, target)
        slot = local_slot(g, name)
        if slot == 0:
            return gerr(g, "codegen: unknown local '" + name + "'")
        lty = local_tag(g, name)
        g = emit_expr(g, value)
        if g.err == 1:
            return g
        if is_agg(ty_tag(g.c, lty)) == 1:
            if g.rk != RK_STRUCT() or ty_eq(g.c, lty, g.rt) == 0:
                return gerr(g, "codegen: aggregate assignment type mismatch")
            return memcpy_agg(g, slot, g.rv, lty)
        want = tag_kind(ty_tag(g.c, lty))
        if g.rk != want:
            return gerr(g, "codegen: assignment kind mismatch for '" + name + "'")
        LLVMBuildStore(g.builder, g.rv, slot)
        return g
    if t == N_FIELDACCESS():
        g = emit_field_ptr(g, target)
        if g.err == 1:
            return g
        fptr = g.rv
        fty = g.rt
        g = emit_expr(g, value)
        if g.err == 1:
            return g
        if is_agg(ty_tag(g.c, fty)) == 1:
            if g.rk != RK_STRUCT():
                return gerr(g, "codegen: aggregate field assignment requires a value")
            return memcpy_agg(g, fptr, g.rv, fty)
        want = tag_kind(ty_tag(g.c, fty))
        if g.rk != want:
            return gerr(g, "codegen: field assignment kind mismatch")
        LLVMBuildStore(g.builder, g.rv, fptr)
        return g
    if t == N_INDEX():
        g = emit_index_ptr(g, target)
        if g.err == 1:
            return g
        eptr = g.rv
        ety = g.rt
        g = emit_expr(g, value)
        if g.err == 1:
            return g
        if is_agg(ty_tag(g.c, ety)) == 1:
            if g.rk != RK_STRUCT() or ty_eq(g.c, ety, g.rt) == 0:
                return gerr(g, "codegen: aggregate element assignment type mismatch")
            return memcpy_agg(g, eptr, g.rv, ety)
        want = tag_kind(ty_tag(g.c, ety))
        if g.rk != want:
            return gerr(g, "codegen: element assignment kind mismatch")
        LLVMBuildStore(g.builder, g.rv, eptr)
        return g
    return gerr(g, "codegen: unsupported assignment target")

def emit_return(g: Gen, stmt: int) -> Gen:
    e = node_child(g.c.p, stmt)
    rty = vec_get(g.c.fn_ret, g.cur_fni)
    if e == -1:
        if ty_tag(g.c, rty) != TY_VOID():
            return gerr(g, "codegen: missing return value")
        LLVMBuildRetVoid(g.builder)
        g.term = 1
        return g
    tag = ty_tag(g.c, rty)
    if tag == TY_VOID():
        return gerr(g, "codegen: void function cannot return a value")
    if is_agg(tag) == 1:
        g = emit_expr(g, e)
        if g.err == 1:
            return g
        if g.rk != RK_STRUCT():
            return gerr(g, "codegen: aggregate return requires a value")
        out = LLVMGetParam(vec_get(g.fn_ref, g.cur_fni), 0)
        g = memcpy_agg(g, out, g.rv, rty)
        LLVMBuildRetVoid(g.builder)
        g.term = 1
        return g
    want = tag_kind(tag)
    if want == -1:
        return gerr(g, "codegen: unsupported return type")
    g = emit_expr(g, e)
    if g.err == 1:
        return g
    if g.rk != want:
        return gerr(g, "codegen: return kind mismatch")
    LLVMBuildRet(g.builder, g.rv)
    g.term = 1
    return g

def emit_if(g: Gen, stmt: int) -> Gen:
    cond = node_child(g.c.p, stmt)
    then_b = node_next(g.c.p, cond)
    else_b = node_next(g.c.p, then_b)
    g = emit_expr(g, cond)
    if g.err == 1:
        return g
    if g.rk != RK_BOOL():
        return gerr(g, "codegen: 'if' condition must be bool")
    cv = g.rv
    then_bb = add_bb(g, "if.then")
    if else_b == -1:
        after = add_bb(g, "if.after")
        LLVMBuildCondBr(g.builder, cv, then_bb, after)
        g = pos(g, then_bb)
        g = emit_block(g, then_b)
        if g.err == 1:
            return g
        if g.term == 0:
            LLVMBuildBr(g.builder, after)
        return pos(g, after)
    else_bb = add_bb(g, "if.else")
    LLVMBuildCondBr(g.builder, cv, then_bb, else_bb)
    g = pos(g, then_bb)
    g = emit_block(g, then_b)
    if g.err == 1:
        return g
    then_term = g.term
    # a nested compound in the branch may have moved the builder: remember
    # the real end block of each path to branch from
    then_end = LLVMGetInsertBlock(g.builder)
    g = pos(g, else_bb)
    g = emit_block(g, else_b)
    if g.err == 1:
        return g
    else_term = g.term
    else_end = LLVMGetInsertBlock(g.builder)
    if then_term == 1 and else_term == 1:
        g.term = 1
        return g
    after = add_bb(g, "if.after")
    if then_term == 0:
        LLVMPositionBuilderAtEnd(g.builder, then_end)
        LLVMBuildBr(g.builder, after)
    if else_term == 0:
        LLVMPositionBuilderAtEnd(g.builder, else_end)
        LLVMBuildBr(g.builder, after)
    return pos(g, after)

def emit_while(g: Gen, stmt: int) -> Gen:
    cond = node_child(g.c.p, stmt)
    body_b = node_next(g.c.p, cond)
    cond_bb = add_bb(g, "while.cond")
    body_bb = add_bb(g, "while.body")
    after = add_bb(g, "while.after")
    LLVMBuildBr(g.builder, cond_bb)
    g = pos(g, cond_bb)
    g = emit_expr(g, cond)
    if g.err == 1:
        return g
    if g.rk != RK_BOOL():
        return gerr(g, "codegen: 'while' condition must be bool")
    LLVMBuildCondBr(g.builder, g.rv, body_bb, after)
    g.loop_cont = vec_push(g.loop_cont, cond_bb)
    g.loop_after = vec_push(g.loop_after, after)
    g = pos(g, body_bb)
    g = emit_block(g, body_b)
    g.loop_cont = vec_pop(g.loop_cont)
    g.loop_after = vec_pop(g.loop_after)
    if g.err == 1:
        return g
    if g.term == 0:
        LLVMBuildBr(g.builder, cond_bb)
    return pos(g, after)

def emit_for(g: Gen, stmt: int) -> Gen:
    if node_ival(g.c.p, stmt) != 1:
        return emit_for_array(g, stmt)
    var = node_sval(g.c.p, stmt)
    args = node_child(g.c.p, stmt)
    start = 0
    end = 0
    step = 0
    nargs = 0
    a = args
    while a != -1:
        if node_tag(g.c.p, a) == N_BLOCK():
            a = -1
        else:
            g = emit_expr(g, a)
            if g.err == 1:
                return g
            if nargs == 0:
                start = g.rv
            elif nargs == 1:
                end = g.rv
            else:
                step = g.rv
            nargs = nargs + 1
            a = node_next(g.c.p, a)
    if nargs == 1:
        # range(n): the single argument is the end
        end = start
        start = LLVMConstInt(g.i64, 0, 1)
        step = LLVMConstInt(g.i64, 1, 1)
    elif nargs == 2:
        step = LLVMConstInt(g.i64, 1, 1)
    if nargs < 1 or nargs > 3:
        return gerr(g, "codegen: range expects 1 to 3 arguments")
    i_slot = alloca_entry(g, g.i64, "for.i")
    LLVMBuildStore(g.builder, start, i_slot)
    var_slot = alloca_entry(g, g.i64, var)
    g.loc_name = vec_push(g.loc_name, as_ptr(var))
    g.loc_slot = vec_push(g.loc_slot, var_slot)
    g.loc_tag = vec_push(g.loc_tag, g.c.t_int)
    header = add_bb(g, "for.cond")
    body_bb = add_bb(g, "for.body")
    inc_bb = add_bb(g, "for.inc")
    after = add_bb(g, "for.after")
    LLVMBuildBr(g.builder, header)
    g = pos(g, header)
    iv = LLVMBuildLoad2(g.builder, g.i64, i_slot, "for.i")
    step_pos = LLVMBuildICmp(g.builder, ICMP_SGT(), step, LLVMConstInt(g.i64, 0, 1), "for.steppos")
    lt = LLVMBuildICmp(g.builder, ICMP_SLT(), iv, end, "for.lt")
    gt = LLVMBuildICmp(g.builder, ICMP_SGT(), iv, end, "for.gt")
    keep = LLVMBuildSelect(g.builder, step_pos, lt, gt, "for.keep")
    LLVMBuildCondBr(g.builder, keep, body_bb, after)
    g.loop_cont = vec_push(g.loop_cont, inc_bb)
    g.loop_after = vec_push(g.loop_after, after)
    g = pos(g, body_bb)
    LLVMBuildStore(g.builder, iv, var_slot)
    body = node_child(g.c.p, stmt)
    while node_next(g.c.p, body) != -1:
        body = node_next(g.c.p, body)
    g = emit_block(g, body)
    g.loop_cont = vec_pop(g.loop_cont)
    g.loop_after = vec_pop(g.loop_after)
    if g.err == 1:
        return g
    if g.term == 0:
        LLVMBuildBr(g.builder, inc_bb)
    g = pos(g, inc_bb)
    iv2 = LLVMBuildLoad2(g.builder, g.i64, i_slot, "for.i")
    nxt = LLVMBuildAdd(g.builder, iv2, step, "for.next")
    LLVMBuildStore(g.builder, nxt, i_slot)
    LLVMBuildBr(g.builder, header)
    return pos(g, after)

# for x in arr: hidden i64 index, element copied into the loop variable
def emit_for_array(g: Gen, stmt: int) -> Gen:
    var = node_sval(g.c.p, stmt)
    arr_e = node_child(g.c.p, stmt)
    g = emit_expr(g, arr_e)
    if g.err == 1:
        return g
    if g.rk != RK_STRUCT() or ty_tag(g.c, g.rt) != TY_ARRAY():
        return gerr(g, "codegen: 'for' can only iterate over arrays")
    aty = g.rt
    base = g.rv
    ety = ty_elem(g.c, aty)
    n = ty_len(g.c, aty)
    i_slot = alloca_entry(g, g.i64, "for.i")
    LLVMBuildStore(g.builder, LLVMConstInt(g.i64, 0, 0), i_slot)
    var_slot = alloca_entry(g, ty_ll(g, ety), var)
    g.loc_name = vec_push(g.loc_name, as_ptr(var))
    g.loc_slot = vec_push(g.loc_slot, var_slot)
    g.loc_tag = vec_push(g.loc_tag, ety)
    header = add_bb(g, "for.cond")
    body_bb = add_bb(g, "for.body")
    inc_bb = add_bb(g, "for.inc")
    after = add_bb(g, "for.after")
    LLVMBuildBr(g.builder, header)
    g = pos(g, header)
    iv = LLVMBuildLoad2(g.builder, g.i64, i_slot, "for.i")
    cond = LLVMBuildICmp(g.builder, ICMP_SLT(), iv, LLVMConstInt(g.i64, n, 0), "for.lt")
    LLVMBuildCondBr(g.builder, cond, body_bb, after)
    g.loop_cont = vec_push(g.loop_cont, inc_bb)
    g.loop_after = vec_push(g.loop_after, after)
    g = pos(g, body_bb)
    eptr = elem_ptr(g, base, aty, iv)
    if is_agg(ty_tag(g.c, ety)) == 1:
        g = memcpy_agg(g, var_slot, eptr, ety)
    else:
        val = LLVMBuildLoad2(g.builder, ty_ll(g, ety), eptr, "for.val")
        LLVMBuildStore(g.builder, val, var_slot)
    body = node_child(g.c.p, stmt)
    while node_next(g.c.p, body) != -1:
        body = node_next(g.c.p, body)
    g = emit_block(g, body)
    g.loop_cont = vec_pop(g.loop_cont)
    g.loop_after = vec_pop(g.loop_after)
    if g.err == 1:
        return g
    if g.term == 0:
        LLVMBuildBr(g.builder, inc_bb)
    g = pos(g, inc_bb)
    iv2 = LLVMBuildLoad2(g.builder, g.i64, i_slot, "for.i")
    nxt = LLVMBuildAdd(g.builder, iv2, LLVMConstInt(g.i64, 1, 0), "for.next")
    LLVMBuildStore(g.builder, nxt, i_slot)
    LLVMBuildBr(g.builder, header)
    return pos(g, after)

# ---- function bodies ----

def emit_fn(g: Gen, fni: int, node: int) -> Gen:
    g.cur_fni = fni
    g.loc_name = vec_new()
    g.loc_slot = vec_new()
    g.loc_tag = vec_new()
    g.loop_cont = vec_new()
    g.loop_after = vec_new()
    g = pos(g, vec_get(g.entry, fni))
    ref = vec_get(g.fn_ref, fni)
    rty0 = vec_get(g.c.fn_ret, fni)
    hidden = 0
    if is_agg(ty_tag(g.c, rty0)) == 1:
        hidden = 1
    k = 0
    kid = node_child(g.c.p, node)
    body = -1
    while kid != -1:
        t = node_tag(g.c.p, kid)
        if t == N_BLOCK():
            body = kid
        elif t == N_PARAM():
            pname = node_sval(g.c.p, kid)
            pty = sig_param_ty(g.c, fni, k)
            ptag = ty_tag(g.c, pty)
            if is_agg(ptag) == 1:
                ll = ty_ll(g, pty)
                if ll == 0 or ll == -1:
                    return gerr(g, "codegen: unknown aggregate parameter type")
                slot = alloca_entry(g, ll, pname)
                # callee copies the caller's aggregate (value semantics)
                g = memcpy_agg(g, slot, LLVMGetParam(ref, k + hidden), pty)
            elif tag_kind(ptag) == -1:
                return gerr(g, "codegen: unsupported parameter type")
            else:
                ll = ty_ll(g, pty)
                slot = alloca_entry(g, ll, pname)
                LLVMBuildStore(g.builder, LLVMGetParam(ref, k + hidden), slot)
            g.loc_name = vec_push(g.loc_name, as_ptr(pname))
            g.loc_slot = vec_push(g.loc_slot, slot)
            g.loc_tag = vec_push(g.loc_tag, pty)
            k = k + 1
        kid = node_next(g.c.p, kid)
    if body == -1:
        return gerr(g, "codegen: malformed function body")
    g = emit_block(g, body)
    if g.err == 1:
        return g
    if g.term == 0:
        rty = vec_get(g.c.fn_ret, fni)
        if ty_tag(g.c, rty) == TY_VOID():
            LLVMBuildRetVoid(g.builder)
        else:
            LLVMBuildUnreachable(g.builder)
        g.term = 1
    return g

# ---- program ----

def declare_structs(g: Gen) -> Gen:
    c = g.c
    # phase 1: reserve named types (two-phase so structs can refer to each other)
    i = 0
    while i < c.sf_struct.len:
        sname = as_string(vec_get(c.sf_struct, i))
        if as_string(vec_get(c.sf_name, i)) == "":
            if LLVMGetTypeByName(g.module, sname) == 0:
                LLVMStructCreateNamed(g.ctx, sname)
        i = i + 1
    # phase 2: bodies, fields in declaration order
    i = 0
    while i < c.sf_struct.len:
        sname = as_string(vec_get(c.sf_struct, i))
        if as_string(vec_get(c.sf_name, i)) == "":
            n = struct_field_count(c, sname)
            buf = malloc(8)
            if n > 0:
                buf = malloc(n * 8)
            k = 0
            j = 0
            while j < c.sf_struct.len and g.err == 0:
                if as_string(vec_get(c.sf_struct, j)) == sname and as_string(vec_get(c.sf_name, j)) != "":
                    ll = ty_ll(g, vec_get(c.sf_ty, j))
                    if ll == 0 or ll == -1:
                        return gerr(g, "codegen: unsupported field type in struct '" + sname + "'")
                    store_i64(buf + k * 8, ll)
                    k = k + 1
                j = j + 1
            LLVMStructSetBody(LLVMGetTypeByName(g.module, sname), buf, n, 0)
        i = i + 1
    return g

def gen_program(g: Gen) -> Gen:
    c = g.c
    root = c.p.root
    g = declare_structs(g)
    if g.err == 1:
        return g
    # declare concrete + extern functions
    ch = node_child(c.p, root)
    while ch != -1 and g.err == 0:
        t = node_tag(c.p, ch)
        if (t == N_FN() or t == N_EXTERN()) and is_generic_fn(c, ch) == 0:
            name = node_sval(c.p, ch)
            fni = sig_index(c, name)
            if fni != -1:
                g = declare_fn(g, fni, ch)
        ch = node_next(c.p, ch)
    # declare monomorphized instances
    i = 0
    while i < c.inst_fni.len and g.err == 0:
        g = declare_fn(g, vec_get(c.inst_fni, i), vec_get(c.inst_node, i))
        i = i + 1
    if g.err == 1:
        return g
    # C entry wrapper (declared before user bodies, like the Rust codegen)
    main_fni = sig_index(c, "main")
    if main_fni == -1:
        return gerr(g, "codegen: program has no 'main'")
    main_ty = LLVMFunctionType(g.i32, 0, 0, 0)
    wrapper = LLVMAddFunction(g.module, "main", main_ty)
    wbb = LLVMAppendBasicBlockInContext(g.ctx, wrapper, "entry")
    g = pos(g, wbb)
    g.cur_fni = main_fni
    # deterministic output: stdout to binary mode, like the Rust codegen.
    # _setmode is Windows-CRT only; POSIX stdout is already binary-safe.
    if target_os() == "windows":
        setmode_params = malloc(16)
        store_i64(setmode_params, g.i32)
        store_i64(setmode_params + 8, g.i32)
        setmode_ty = LLVMFunctionType(g.i32, setmode_params, 2, 0)
        setmode = LLVMAddFunction(g.module, "_setmode", setmode_ty)
        setmode_args = malloc(16)
        store_i64(setmode_args, LLVMConstInt(g.i32, 1, 0))
        store_i64(setmode_args + 8, LLVMConstInt(g.i32, 32768, 0))
        LLVMBuildCall2(g.builder, setmode_ty, setmode, setmode_args, 2, "")
    rty = vec_get(c.fn_ret, main_fni)
    if is_agg(ty_tag(c, rty)) == 1:
        # compound-returning main: pass the sret out-pointer, exit 0
        stmp = LLVMBuildAlloca(g.builder, ty_ll(g, rty), "main.ret")
        margs = malloc(8)
        store_i64(margs, stmp)
        LLVMBuildCall2(g.builder, vec_get(g.fn_llty, main_fni), vec_get(g.fn_ref, main_fni), margs, 1, "")
        LLVMBuildRet(g.builder, LLVMConstInt(g.i32, 0, 0))
    else:
        call = LLVMBuildCall2(g.builder, vec_get(g.fn_llty, main_fni), vec_get(g.fn_ref, main_fni), 0, 0, "")
        if ty_tag(c, rty) == TY_INT():
            v = LLVMBuildTrunc(g.builder, call, g.i32, "exitcode")
            LLVMBuildRet(g.builder, v)
        else:
            LLVMBuildRet(g.builder, LLVMConstInt(g.i32, 0, 0))
    # bodies: concrete then instances
    ch = node_child(c.p, root)
    while ch != -1 and g.err == 0:
        t = node_tag(c.p, ch)
        if t == N_FN() and is_generic_fn(c, ch) == 0:
            name = node_sval(c.p, ch)
            fni = sig_index(c, name)
            if fni != -1:
                g = emit_fn(g, fni, ch)
        ch = node_next(c.p, ch)
    i = 0
    while i < c.inst_fni.len and g.err == 0:
        g = emit_fn(g, vec_get(c.inst_fni, i), vec_get(c.inst_node, i))
        i = i + 1
    return g

# unoptimized module IR as text (the self-hosted `aoxn ir`). The returned
# buffer belongs to LLVM and is intentionally never freed (compiler process).
def gen_ir_text(g: Gen) -> string:
    if g.module == 0:
        return ""
    return LLVMPrintModuleToString(g.module)

def gen_emit_object(g: Gen, out_path: string) -> Gen:
    if g.err == 1:
        return g
    # verify before touching the target machine
    msg_slot = malloc(8)
    store_i64(msg_slot, 0)
    if LLVMVerifyModule(g.module, 1, msg_slot) != 0:
        mptr = load_i64(msg_slot)
        if mptr != 0:
            return gerr(g, "codegen: module verification failed: " + as_string(mptr))
        return gerr(g, "codegen: module verification failed")
    triple = LLVMGetDefaultTargetTriple()
    LLVMSetTarget(g.module, triple)
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    tslot = malloc(8)
    store_i64(tslot, 0)
    eslot = malloc(8)
    store_i64(eslot, 0)
    if LLVMGetTargetFromTriple(triple, tslot, eslot) != 0:
        eptr = load_i64(eslot)
        if eptr != 0:
            return gerr(g, "codegen: cannot resolve target: " + as_string(eptr))
        return gerr(g, "codegen: cannot resolve target")
    tm = LLVMCreateTargetMachine(load_i64(tslot), triple, "", "", CG_O3(), CG_RELOC(), 0)
    if tm == 0:
        return gerr(g, "codegen: cannot create target machine")
    dl = LLVMCreateTargetDataLayout(tm)
    LLVMSetModuleDataLayout(g.module, dl)
    opts = LLVMCreatePassBuilderOptions()
    perr = LLVMRunPasses(g.module, "default<O3>", tm, opts)
    LLVMDisposePassBuilderOptions(opts)
    if perr != 0:
        return gerr(g, "codegen: optimization pipeline failed: " + as_string(perr))
    eslot2 = malloc(8)
    store_i64(eslot2, 0)
    if LLVMTargetMachineEmitToFile(tm, g.module, out_path, CG_OBJECT(), eslot2) != 0:
        eptr2 = load_i64(eslot2)
        if eptr2 != 0:
            return gerr(g, "codegen: cannot emit object: " + as_string(eptr2))
        return gerr(g, "codegen: cannot emit object file '" + out_path + "'")
    LLVMDisposeTargetMachine(tm)
    return g

def gen_dispose(g: Gen) -> Gen:
    if g.builder != 0:
        LLVMDisposeBuilder(g.builder)
    if g.module != 0:
        LLVMDisposeModule(g.module)
    LLVMContextDispose(g.ctx)
    return g
